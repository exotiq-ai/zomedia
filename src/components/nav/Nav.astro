---
import { Image } from 'astro:assets';
import zoLogo from '../../assets/images/zo-media/zologo.png';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/books/', label: 'Books' },
  {
    href: '/film-projects/',
    label: 'Film Projects',
    children: [
      { href: '/film-projects/screenplays/', label: 'Screenplays' },
      { href: '/film-projects/theatrical-works/', label: 'Theatrical Works' },
      { href: '/film-projects/documentaries/', label: 'Documentaries & Film Shorts' },
    ],
  },
  { href: '/the-wire/', label: "Phuckin' Wire" },
  { href: '/staff-and-volunteers/', label: 'Staff' },
  { href: '/board-of-directors/', label: 'Board' },
  { href: '/advisory-board/', label: 'Advisory' },
  { href: '/special-projects/', label: 'Special Projects' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav__inner">
    <a href="/" class="nav__logo">
      <Image src={zoLogo} alt="Zo Media Productions" width={160} height={60} loading="eager" fetchpriority="high" format="webp" />
    </a>

    <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle menu">
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>

    <ul class="nav__menu" id="nav-menu" role="list">
      {links.map((link) => (
        <li class={`nav__item ${link.children ? 'nav__item--has-dropdown' : ''}`}>
          <a
            href={link.href}
            class="nav__link"
            {...(isActive(link.href) ? { 'aria-current': 'page' } : {})}
          >
            {link.label}
          </a>
          {link.children && (
            <ul class="nav__dropdown" role="list">
              {link.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class="nav__dropdown-link"
                    {...(isActive(child.href) ? { 'aria-current': 'page' } : {})}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="nav__item nav__item--cta">
        <a href="/support/" class="btn btn--primary btn--sm">Donate</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    transition:
      background var(--duration-normal) var(--ease-snap),
      backdrop-filter var(--duration-normal) var(--ease-snap);
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgba(10, 10, 11, 0.9);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom-color: var(--color-border);
  }

  .nav__inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-md) var(--grid-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .nav__logo img {
    height: 64px;
    width: auto;
    filter: brightness(0) invert(1);
    transition: opacity var(--duration-fast);
  }
  .nav__logo:hover img { opacity: 0.8; }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
    padding: var(--space-sm) var(--space-sm);
    position: relative;
    transition: color var(--duration-fast) var(--ease-snap);
    white-space: nowrap;
  }
  .nav__link:hover { color: var(--color-bone); }
  .nav__link[aria-current="page"] { color: var(--color-bone); }
  .nav__link[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: var(--space-sm);
    right: var(--space-sm);
    height: 2px;
    background: var(--color-signal);
  }

  /* Dropdown */
  .nav__item--has-dropdown { position: relative; }
  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-graphite);
    border: 1px solid var(--color-border);
    min-width: 220px;
    padding: var(--space-sm) 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--duration-fast) var(--ease-snap),
      transform var(--duration-fast) var(--ease-snap),
      visibility var(--duration-fast);
  }
  .nav__item--has-dropdown:hover .nav__dropdown,
  .nav__item--has-dropdown:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__dropdown-link {
    display: block;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
    transition: color var(--duration-fast), background var(--duration-fast);
  }
  .nav__dropdown-link:hover {
    color: var(--color-bone);
    background: var(--color-slate);
  }

  /* Mobile toggle */
  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-sm);
    z-index: 101;
  }
  .nav__toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-bone);
    transition: transform var(--duration-fast) var(--ease-snap), opacity var(--duration-fast);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ───────────────────────────────────────────────────────────
   * MOBILE NAV — editorial "Index" treatment.
   *
   * Big serif items, mono index numerals (CSS counter), hairline
   * dividers, signal-red active state, full-width Donate CTA pinned
   * to the bottom. Items stagger-fade in when the menu opens.
   * ─────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    /* IMPORTANT: do NOT set backdrop-filter or transform/filter/perspective
     * on .nav at this breakpoint. Any of those properties would make .nav
     * the containing block for the fixed-positioned .nav__menu, clipping
     * the full-screen overlay to the nav's own height. The opaque-ish
     * background alone is enough on mobile. */
    .nav {
      background: rgba(10, 10, 11, 0.95);
      backdrop-filter: none;
    }
    .nav.is-scrolled {
      backdrop-filter: none; /* mobile override — same containing-block reason */
    }
    .nav__toggle { display: flex; }

    /* The full-screen overlay */
    .nav__menu {
      position: fixed;
      inset: 0;
      background: var(--color-void);
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      gap: 0;
      transform: translateY(-100%);
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 99;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: calc(var(--space-3xl) + var(--space-2xl)) var(--grid-margin) var(--space-2xl);
      counter-reset: nav-counter;
    }
    .nav__menu.is-open { transform: translateY(0); }

    /* Subtle paper-fiber texture on the menu surface */
    .nav__menu::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.04;
      background-image:
        repeating-linear-gradient(45deg, var(--color-bone) 0 1px, transparent 1px 3px),
        repeating-linear-gradient(-45deg, var(--color-bone) 0 1px, transparent 1px 5px);
      mix-blend-mode: overlay;
    }

    /* Index label at the very top of the menu */
    .nav__menu::after {
      content: 'Index';
      position: absolute;
      top: var(--space-2xl);
      left: var(--grid-margin);
      right: var(--grid-margin);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      letter-spacing: var(--tracking-mega);
      text-transform: uppercase;
      color: var(--color-wire);
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--color-border-emphasis);
    }

    /* Item rows */
    .nav__item {
      counter-increment: nav-counter;
      border-bottom: 1px solid var(--color-border);
      position: relative;
    }

    /* Editorial serif links — big, bone, left-aligned */
    .nav__link {
      display: flex;
      align-items: baseline;
      gap: var(--space-md);
      font-family: var(--font-headline);
      font-size: clamp(1.75rem, 6vw, 2.25rem);
      letter-spacing: var(--tracking-tight);
      text-transform: none;
      color: var(--color-bone);
      line-height: 1.1;
      padding: var(--space-lg) 0;
      transition: color var(--duration-fast) var(--ease-snap),
                  padding-left var(--duration-fast) var(--ease-snap);
      white-space: normal;
    }
    .nav__link::before {
      content: counter(nav-counter, decimal-leading-zero);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 400;
      color: var(--color-fog);
      letter-spacing: var(--tracking-mega);
      flex-shrink: 0;
      min-width: 2.5em;
      align-self: flex-start;
      padding-top: 0.85em;
    }
    .nav__link:active,
    .nav__link:hover {
      color: var(--color-signal);
      padding-left: var(--space-sm);
    }
    .nav__link[aria-current="page"] {
      color: var(--color-signal);
    }
    .nav__link[aria-current="page"]::before {
      color: var(--color-signal);
    }
    .nav__link[aria-current="page"]::after {
      display: none; /* desktop underline doesn't apply on mobile */
    }

    /* Dropdown nested under its parent */
    .nav__dropdown {
      position: static;
      background: transparent;
      border: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      min-width: 0;
      display: flex;
      flex-direction: column;
      padding: 0 0 var(--space-md) calc(2.5em + var(--space-md));
    }
    .nav__dropdown-link {
      font-family: var(--font-headline);
      font-size: 1.125rem;
      text-transform: none;
      letter-spacing: 0;
      color: var(--color-fog);
      padding: var(--space-xs) 0;
      transition: color var(--duration-fast), padding-left var(--duration-fast);
    }
    .nav__dropdown-link:hover,
    .nav__dropdown-link:focus,
    .nav__dropdown-link[aria-current="page"] {
      color: var(--color-bone);
      background: transparent;
      padding-left: var(--space-xs);
    }

    /* Donate CTA — promoted to a full-width primary anchor at the bottom */
    .nav__item--cta {
      counter-increment: none;
      border-bottom: none;
      margin-top: var(--space-xl);
    }
    .nav__item--cta .btn {
      width: 100%;
      justify-content: center;
      padding: var(--space-md) var(--space-lg);
      font-size: var(--text-small);
    }

    /* Stagger items in as the menu opens */
    @media (prefers-reduced-motion: no-preference) {
      .nav__menu .nav__item {
        opacity: 0;
        transform: translateY(12px);
      }
      .nav__menu.is-open .nav__item {
        animation: nav-item-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      .nav__menu.is-open .nav__item:nth-child(1) { animation-delay: 200ms; }
      .nav__menu.is-open .nav__item:nth-child(2) { animation-delay: 260ms; }
      .nav__menu.is-open .nav__item:nth-child(3) { animation-delay: 320ms; }
      .nav__menu.is-open .nav__item:nth-child(4) { animation-delay: 380ms; }
      .nav__menu.is-open .nav__item:nth-child(5) { animation-delay: 440ms; }
      .nav__menu.is-open .nav__item:nth-child(6) { animation-delay: 500ms; }
      .nav__menu.is-open .nav__item:nth-child(7) { animation-delay: 560ms; }
      .nav__menu.is-open .nav__item:nth-child(8) { animation-delay: 600ms; }
      .nav__menu.is-open .nav__item:nth-child(9) { animation-delay: 640ms; }
      .nav__menu.is-open .nav__item:nth-child(10) { animation-delay: 680ms; }
      .nav__menu.is-open .nav__item:nth-child(n+11) { animation-delay: 720ms; }

      @keyframes nav-item-in {
        to { opacity: 1; transform: translateY(0); }
      }
    }
  }
</style>
