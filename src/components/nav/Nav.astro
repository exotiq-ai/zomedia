---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/books/', label: 'Books' },
  {
    href: '/film-projects/',
    label: 'Film Projects',
    children: [
      { href: '/film-projects/screenplays/', label: 'Screenplays' },
      { href: '/film-projects/theatrical-works/', label: 'Theatrical Works' },
      { href: '/film-projects/documentaries/', label: 'Documentaries & Film Shorts' },
    ],
  },
  { href: '/the-wire/', label: "Phuckin' Wire" },
  { href: '/staff-and-volunteers/', label: 'Staff' },
  { href: '/board-of-directors/', label: 'Board' },
  { href: '/advisory-board/', label: 'Advisory' },
  { href: '/special-projects/', label: 'Special Projects' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav__inner">
    <a href="/" class="nav__logo">
      <img src="/assets/images/zo-media/zologo.png" alt="Zo Media Productions" width="160" height="60" />
    </a>

    <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle menu">
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>

    <ul class="nav__menu" id="nav-menu" role="list">
      {links.map((link) => (
        <li class={`nav__item ${link.children ? 'nav__item--has-dropdown' : ''}`}>
          <a
            href={link.href}
            class="nav__link"
            {...(isActive(link.href) ? { 'aria-current': 'page' } : {})}
          >
            {link.label}
          </a>
          {link.children && (
            <ul class="nav__dropdown" role="list">
              {link.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class="nav__dropdown-link"
                    {...(isActive(child.href) ? { 'aria-current': 'page' } : {})}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="nav__item nav__item--cta">
        <a href="/support/" class="btn btn--primary btn--sm">Donate</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    transition:
      background var(--duration-normal) var(--ease-snap),
      backdrop-filter var(--duration-normal) var(--ease-snap);
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgba(10, 10, 11, 0.9);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom-color: var(--color-border);
  }

  .nav__inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-md) var(--grid-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .nav__logo img {
    height: 64px;
    width: auto;
    filter: brightness(0) invert(1);
    transition: opacity var(--duration-fast);
  }
  .nav__logo:hover img { opacity: 0.8; }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
    padding: var(--space-sm) var(--space-sm);
    position: relative;
    transition: color var(--duration-fast) var(--ease-snap);
    white-space: nowrap;
  }
  .nav__link:hover { color: var(--color-bone); }
  .nav__link[aria-current="page"] { color: var(--color-bone); }
  .nav__link[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: var(--space-sm);
    right: var(--space-sm);
    height: 2px;
    background: var(--color-signal);
  }

  /* Dropdown */
  .nav__item--has-dropdown { position: relative; }
  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-graphite);
    border: 1px solid var(--color-border);
    min-width: 220px;
    padding: var(--space-sm) 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--duration-fast) var(--ease-snap),
      transform var(--duration-fast) var(--ease-snap),
      visibility var(--duration-fast);
  }
  .nav__item--has-dropdown:hover .nav__dropdown,
  .nav__item--has-dropdown:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__dropdown-link {
    display: block;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
    transition: color var(--duration-fast), background var(--duration-fast);
  }
  .nav__dropdown-link:hover {
    color: var(--color-bone);
    background: var(--color-slate);
  }

  /* Mobile toggle */
  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-sm);
    z-index: 101;
  }
  .nav__toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-bone);
    transition: transform var(--duration-fast) var(--ease-snap), opacity var(--duration-fast);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .nav__toggle { display: flex; }
    .nav__menu {
      position: fixed;
      inset: 0;
      background: var(--color-void);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: var(--space-lg);
      transform: translateY(-100%);
      transition: transform var(--duration-normal) var(--ease-snap);
      z-index: 99;
    }
    .nav__menu.is-open {
      transform: translateY(0);
    }
    .nav__link {
      font-size: var(--text-small);
      padding: var(--space-sm) var(--space-md);
    }
    .nav__dropdown {
      position: static;
      background: transparent;
      border: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      min-width: auto;
      padding: 0;
      padding-left: var(--space-lg);
    }
    .nav__dropdown-link {
      padding: var(--space-xs) var(--space-md);
    }
  }
</style>
