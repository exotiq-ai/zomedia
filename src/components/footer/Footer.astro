---
import { Image } from 'astro:assets';
import zoLogo from '../../assets/images/zo-media/zologo.png';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Staff & Volunteers', href: '/staff-and-volunteers/' },
  { label: 'Board of Directors', href: '/board-of-directors/' },
  { label: 'Advisory Board', href: '/advisory-board/' },
  { label: 'Books', href: '/books/' },
  { label: 'Film Projects', href: '/film-projects/' },
  { label: "Phuckin' Wire", href: '/the-wire/' },
  { label: 'Special Projects', href: '/special-projects/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Support', href: '/support/' },
];

// Social links. Facebook + Instagram are live (UBFSF accounts);
// X and YouTube stay pending until those accounts are confirmed.
const socialLinks = [
  { label: 'Facebook',  icon: 'fb', href: 'https://www.facebook.com/unitedblack.familyscholarshipfoundation' },
  { label: 'Instagram', icon: 'ig', href: 'https://www.instagram.com/ubfsforg/' },
  { label: 'X / Twitter', icon: 'x', href: null },
  { label: 'YouTube',   icon: 'yt', href: null },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <Image src={zoLogo} alt="Zo Media Productions" width={200} height={75} loading="lazy" format="webp" />
      </a>
      <p class="footer__tagline">Amplifying incarcerated voices through literature, film, and art.</p>
      <p class="footer__org">A subsidiary of the United Black Family Scholarship Foundation, a 501(c)(3) organization.</p>
    </div>

    <nav class="footer__nav" aria-label="Footer navigation">
      <span class="footer__nav-label">Navigate</span>
      <ul role="list">
        {footerLinks.map((link) => (
          <li><a href={link.href} class="footer__link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__newsletter">
      <span class="footer__nav-label">Request Updates</span>
      <p class="footer__newsletter-text">Request updates from Zo Media and The Phuckin' Wire while our mailing-list service is being finalized.</p>
      <form class="footer__form" data-netlify="true" name="footer-updates-interest" method="POST">
        <input type="hidden" name="form-name" value="footer-updates-interest" />
        <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" class="footer__input" />
        <button type="submit" class="btn btn--primary btn--sm">Request</button>
      </form>
    </div>

    <div class="footer__social">
      <span class="footer__nav-label">Follow</span>
      <div class="footer__social-links">
        {socialLinks.map((link) => (
          link.href ? (
            <a href={link.href} class="footer__social-link" aria-label={link.label} target="_blank" rel="noopener noreferrer">
              <img src={`/assets/icons/${link.icon}.svg`} alt="" width="20" height="20" />
            </a>
          ) : (
            <span class="footer__social-link footer__social-link--pending" aria-label={`${link.label} (coming soon)`} title={`${link.label} (coming soon)`}>
              <img src={`/assets/icons/${link.icon}.svg`} alt="" width="20" height="20" />
            </span>
          )
        ))}
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <p>&copy; {currentYear} Zo Media Productions, LLC. All rights reserved.</p>
      <p class="footer__address">P.O. Box 862, Bristow, OK 74010 &middot; <a href="tel:+19189245872">1-918-924-5872</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-soot);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4xl);
  }

  .footer__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-4xl) var(--grid-margin) var(--space-2xl);
    display: grid;
    grid-template-columns: 2fr 1fr 2fr 1fr;
    gap: var(--space-2xl);
  }

  .footer__logo img {
    height: 50px;
    width: auto;
    filter: brightness(0) invert(1);
    margin-bottom: var(--space-md);
  }

  .footer__tagline {
    font-family: var(--font-headline);
    font-size: var(--text-body-lg);
    color: var(--color-bone);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-sm);
  }
  .footer__org {
    font-size: var(--text-small);
    color: var(--color-fog);
  }

  .footer__nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    color: var(--color-wire);
    font-weight: 700;
    margin-bottom: var(--space-lg);
  }

  .footer__link {
    display: block;
    font-size: var(--text-small);
    color: var(--color-fog);
    padding-block: var(--space-xs);
    transition: color var(--duration-fast);
  }
  .footer__link:hover { color: var(--color-bone); }

  .footer__newsletter-text {
    font-size: var(--text-small);
    color: var(--color-fog);
    margin-bottom: var(--space-md);
  }

  .footer__form {
    display: flex;
    gap: var(--space-sm);
  }
  .footer__input {
    flex: 1;
    background: var(--color-graphite);
    border: 1px solid var(--color-slate);
    border-radius: var(--radius-sm);
    color: var(--color-bone);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-small);
    font-family: var(--font-body);
    transition: border-color var(--duration-fast);
  }
  .footer__input:focus {
    outline: none;
    border-color: var(--color-signal);
    box-shadow: 0 0 0 2px var(--color-signal);
  }
  .footer__input::placeholder { color: var(--color-ash); }

  .footer__social-links {
    display: flex;
    gap: var(--space-md);
  }
  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast), background var(--duration-fast);
  }
  .footer__social-link img { filter: brightness(0) invert(0.7); transition: filter var(--duration-fast); }
  .footer__social-link:hover {
    border-color: var(--color-signal);
    background: var(--color-graphite);
  }
  .footer__social-link:hover img { filter: brightness(0) invert(1); }

  /* Pending state — placeholder until real social URLs are available */
  .footer__social-link--pending {
    cursor: default;
    opacity: 0.5;
  }
  .footer__social-link--pending:hover {
    border-color: var(--color-border);
    background: transparent;
  }
  .footer__social-link--pending:hover img { filter: brightness(0) invert(0.7); }

  .footer__bottom {
    border-top: 1px solid var(--color-border);
    background: var(--color-void);
  }
  .footer__bottom-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-lg) var(--grid-margin);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
  }
  .footer__address a {
    color: var(--color-fog);
    transition: color var(--duration-fast);
  }
  .footer__address a:hover { color: var(--color-signal-hot); }

  @media (max-width: 1024px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
    .footer__bottom-inner {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
