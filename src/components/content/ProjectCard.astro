---
interface Props {
  title: string;
  tagline: string;
  heroImage?: string;
  externalUrl?: string;
}

const { title, tagline, heroImage, externalUrl } = Astro.props;
const Tag = externalUrl ? 'a' : 'div';
---

<Tag class="card project-card" {...(externalUrl ? { href: externalUrl, target: '_blank', rel: 'noopener noreferrer' } : {})}>
  <div class="project-card__image">
    {heroImage ? (
      <img src={heroImage} alt={title} loading="lazy" />
    ) : (
      <div class="project-card__gradient" aria-hidden="true"></div>
    )}
  </div>
  <h3 class="card__title">{title}</h3>
  <p class="card__text">{tagline}</p>
  {externalUrl && <span class="card__meta">View Project &rarr;</span>}
</Tag>

<style>
  .project-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: var(--space-md);
  }
  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%) contrast(1.1);
    transition: filter var(--duration-normal);
  }
  .project-card:hover .project-card__image img {
    filter: grayscale(30%) contrast(1.05);
  }
  .project-card__gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-graphite) 0%, var(--color-soot) 50%, var(--color-signal) 150%);
  }
  a.project-card {
    text-decoration: none;
    color: inherit;
  }
</style>
