---
interface Props {
  title: string;
  author: string;
  coverImage: string;
  priceHardcover: string;
  priceEbook: string;
  category: string;
  description: string;
}

const { title, author, coverImage, priceHardcover, priceEbook, category, description } = Astro.props;
---

<article class="card book-card">
  <div class="book-card__cover">
    <img src={coverImage} alt={`Cover of ${title}`} class="img-editorial" loading="lazy" />
  </div>
  <span class="card__meta">{category}</span>
  <h3 class="card__title">{title}</h3>
  <p class="book-card__author">{author}</p>
  <p class="card__text">{description}</p>
  <div class="book-card__prices">
    <span class="book-card__price">Hardcover: {priceHardcover}</span>
    <span class="book-card__price">eBook: {priceEbook}</span>
  </div>
  <a href="#" class="btn btn--primary btn--sm">Add to Cart</a>
</article>

<style>
  .book-card__cover {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    margin-bottom: var(--space-md);
  }
  .book-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book-card__author {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
  }
  .book-card__prices {
    display: flex;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--color-wire);
  }
  .book-card__price {
    white-space: nowrap;
  }
</style>
