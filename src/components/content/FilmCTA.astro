---
/**
 * FilmCTA — call-to-action band shared across all film-project pages.
 * Drives donations (primary) and collaboration inquiries (secondary).
 *
 * Props:
 *   headline   — large editorial headline (default: "Help Bring These Stories to Screen")
 *   body       — supporting paragraph
 *   primaryHref / primaryLabel  — primary action (defaults to donations)
 *   secondaryHref / secondaryLabel — collaborate (defaults to contact form pre-tagged for film)
 */
interface Props {
  headline?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  headline = "Help Bring These Stories to Screen",
  body = "Every film project at Zo Media is created by incarcerated filmmakers. Your contribution directly funds production, post-production, and distribution — putting these stories in front of the audiences that need them.",
  primaryHref = "/support/",
  primaryLabel = "Contribute",
  secondaryHref = "/contact/?type=film",
  secondaryLabel = "Collaborate With Us",
} = Astro.props;
---

<section class="film-cta reveal" aria-labelledby="film-cta-headline">
  <div class="film-cta__inner">
    <span class="eyebrow eyebrow--signal film-cta__eyebrow">Fund the next chapter</span>
    <h2 id="film-cta-headline" class="film-cta__headline">{headline}</h2>
    <p class="film-cta__body">{body}</p>
    <div class="film-cta__actions">
      <a href={primaryHref} class="btn btn--primary btn--lg">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn--outline btn--lg">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .film-cta {
    position: relative;
    background: var(--color-soot);
    padding: var(--space-4xl) var(--grid-margin);
    border-top: 1px solid var(--color-border-emphasis);
    border-bottom: 1px solid var(--color-border-emphasis);
    overflow: hidden;
    isolation: isolate;
  }

  .film-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.04;
    background-image:
      repeating-linear-gradient(45deg, var(--color-bone) 0 1px, transparent 1px 4px);
    z-index: 0;
  }

  .film-cta::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 3px;
    background: var(--color-signal);
    z-index: 1;
  }

  .film-cta__inner {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .film-cta__eyebrow {
    margin-bottom: var(--space-lg);
  }

  .film-cta__headline {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: 0 0 var(--space-lg);
    max-width: 22ch;
  }

  .film-cta__body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-chalk);
    max-width: 60ch;
    margin: 0 0 var(--space-2xl);
  }

  .film-cta__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .film-cta { padding: var(--space-3xl) var(--grid-margin); }
    .film-cta__actions { flex-direction: column; align-items: stretch; }
    .film-cta__actions .btn { width: 100%; justify-content: center; }
  }
</style>
