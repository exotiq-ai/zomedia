---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<SubpageLayout title="About" breadcrumbs={[{ label: "About" }]}>
  <!-- Hero: Editorial (folsom-tower background) -->
  <section class="hero hero--editorial" style="--hero-image: url('/assets/images/zo-media/folsom-tower.jpeg'); --hero-image-position: center; --hero-overlay: 0.7;">
    <div class="hero__inner">
      <h1 class="hero__headline">About Zo Media<br />Productions</h1>
      <p class="hero__subhead">A cooperative publishing house amplifying incarcerated voices through literature, film, and art.</p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="section">
    <div class="container container--narrow reveal">
      <SectionHeader eyebrow="Our Story" title="Built From the Inside Out" />
      <p class="text-lg mt-lg">Zo Media Productions was founded as a subsidiary of the United Black Family Scholarship Foundation (UBFSF), a 501(c)(3) nonprofit organization. What began as a single publication has grown into a full cooperative media house — publishing books, producing film, and exhibiting visual art created by incarcerated people across the country.</p>
      <p class="mt-md">We exist because the stories coming from inside prison walls are some of the most urgent, honest, and necessary narratives in American culture. These are not charity projects. They are works of literature, cinema, and art that stand on their own merit — created by people who happen to be incarcerated.</p>
      <p class="mt-md">Every title we publish, every film we produce, and every exhibition we mount generates real economic opportunity for the creator while opening a window into a system most Americans will never see firsthand.</p>
    </div>
  </section>

  <!-- Founder Pull Quote -->
  <section class="founder-quote">
    <div class="container container--narrow reveal">
      <div class="founder-quote__rule" aria-hidden="true"></div>
      <span class="eyebrow eyebrow--signal founder-quote__eyebrow">Why &ldquo;Zo&rdquo;</span>
      <blockquote class="founder-quote__body">
        <span class="founder-quote__mark" aria-hidden="true">&ldquo;</span>
        <p>I often tell people who&rsquo;ve never experienced prison that we call it <em>the Zo</em> &mdash; short for <em>Twilight Zone</em> &mdash; due to the discombobulation that prisoners experience while incarcerated which makes them more dysfunctional than when they entered the system.</p>
      </blockquote>
      <footer class="founder-quote__cite">
        <span class="founder-quote__name">Ivan Kilgore</span>
        <span class="founder-quote__role">Founder &amp; CEO, Zo Media Productions, LLC.</span>
      </footer>
    </div>
  </section>

  <!-- Cooperative Model -->
  <section class="section section--alt coop" data-coop-reveal>
    <div class="container">
      <header class="coop__header reveal">
        <span class="eyebrow">How We Work</span>
        <h2 class="coop__title">The Cooperative Model</h2>
        <p class="coop__lede">Two pillars hold the cooperative together &mdash; one structural, one financial. Both carry equal weight.</p>
      </header>

      <div class="coop__grid">
        <!-- Pillar 01 — People -->
        <article class="pillar pillar--01">
          <header class="pillar__head">
            <span class="pillar__num">01</span>
            <span class="pillar__cat">People</span>
          </header>
          <h3 class="pillar__title">Co-Chair Partnership</h3>

          <div class="cochair" aria-hidden="true">
            <div class="cochair__node cochair__node--inside">
              <span class="cochair__role">Inside</span>
              <span class="cochair__desc">Currently or formerly incarcerated</span>
            </div>
            <div class="cochair__pivot">
              <span class="cochair__pivot-rule"></span>
              <span class="cochair__pivot-label">Co-Chair</span>
              <span class="cochair__pivot-rule"></span>
            </div>
            <div class="cochair__node cochair__node--outside">
              <span class="cochair__role">Outside</span>
              <span class="cochair__desc">Student or community advocate</span>
            </div>
          </div>

          <div class="pillar__body">
            <p>Every leadership position is co-held by two people with <strong>equal</strong> decision-making authority over editorial direction, project selection, and organizational strategy.</p>
            <p>This is not symbolic. The people whose stories we publish are never separated from the power to shape how those stories reach the world.</p>
          </div>
        </article>

        <!-- Pillar 02 — Capital -->
        <article class="pillar pillar--02">
          <header class="pillar__head">
            <span class="pillar__num">02</span>
            <span class="pillar__cat">Capital</span>
          </header>
          <h3 class="pillar__title">Revenue Model</h3>

          <div class="splitbar" aria-hidden="true">
            <div class="splitbar__row">
              <div class="splitbar__seg splitbar__seg--ubfsf">
                <span class="splitbar__pct" data-coop-pct data-target="50">0%</span>
              </div>
              <div class="splitbar__seg splitbar__seg--coop">
                <span class="splitbar__pct" data-coop-pct data-target="50">0%</span>
              </div>
            </div>
            <div class="splitbar__legend">
              <div class="splitbar__key">
                <span class="splitbar__swatch splitbar__swatch--ubfsf"></span>
                <span>UBFSF Grant Fund</span>
              </div>
              <div class="splitbar__key">
                <span class="splitbar__swatch splitbar__swatch--coop"></span>
                <span>Creators &amp; Reinvestment</span>
              </div>
            </div>
          </div>

          <div class="pillar__body">
            <p><strong>Half of all profits</strong> go directly to the UBFSF Community Grant Fund &mdash; supporting education, reentry programs, and family assistance for incarcerated individuals.</p>
            <p>The remaining half is shared among creators and reinvested into new projects &mdash; keeping the cooperative self-sustaining and creator-owned.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="container reveal">
      <SectionHeader title="Our Values" align="center" />
      <div class="grid grid--3 values-grid mt-2xl">
        <div class="card value-card">
          <div class="signal-line"></div>
          <h3 class="card__title">Creative Excellence</h3>
          <p class="card__text">We publish work that meets the highest editorial and artistic standards. Incarceration does not diminish talent — it sharpens perspective. Our creators produce literature, film, and art that competes on any shelf, any screen, any wall.</p>
        </div>
        <div class="card value-card">
          <div class="signal-line"></div>
          <h3 class="card__title">Economic Equity</h3>
          <p class="card__text">Creators earn from their work. The cooperative model ensures that the people who make the art share in its success — not as an afterthought, but as a founding principle. Revenue flows back to communities, not shareholders.</p>
        </div>
        <div class="card value-card">
          <div class="signal-line"></div>
          <h3 class="card__title">Justice Reform</h3>
          <p class="card__text">Every publication is an act of advocacy. By centering incarcerated voices in mainstream culture, we challenge the narratives that sustain mass incarceration and build public will for systemic change.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- UBFSF Parent Org -->
  <section class="section section--alt">
    <div class="container container--narrow text-center reveal">
      <SectionHeader eyebrow="Our Parent Organization" title="United Black Family Scholarship Foundation" align="center" lede="Zo Media Productions operates as a subsidiary of UBFSF, a registered 501(c)(3) nonprofit organization dedicated to education, family support, and community development for incarcerated individuals and their families." />
      <div class="divider parent-org__divider">
        <span class="divider__label">Contact UBFSF</span>
      </div>
      <p class="parent-org__address">
        United Black Family Scholarship Foundation<br />
        P.O. Box 862, Bristow, OK 74010
      </p>
    </div>
  </section>
</SubpageLayout>

<script src="../scripts/coop-reveal.ts" data-astro-rerun></script>

<style>
  /* ── Values cards override (slightly more padding than default) ── */
  .value-card {
    padding: var(--space-xl);
  }

  /* ── UBFSF Parent Org block ─────────────────────────────── */
  .parent-org__divider {
    margin: var(--space-xl) auto;
  }
  .parent-org__address {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-fog);
  }

  /* ── Founder pull quote ─────────────────────────────────── */
  .founder-quote {
    position: relative;
    background: var(--color-graphite);
    padding: var(--space-3xl) 0;
    overflow: hidden;
  }
  .founder-quote::before {
    /* Subtle vertical signal line on the left */
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-2xl);
    bottom: var(--space-2xl);
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-signal) 20%,
      var(--color-signal) 80%,
      transparent
    );
    opacity: 0.5;
  }
  .founder-quote__rule {
    width: 60px;
    height: 1px;
    background: var(--color-signal);
    margin-bottom: var(--space-lg);
  }
  .founder-quote__eyebrow {
    /* visual styles inherited from .eyebrow + .eyebrow--signal — only positioning here */
    margin-bottom: var(--space-xl);
  }
  .founder-quote__body {
    position: relative;
    margin: 0;
    padding-left: clamp(2.5rem, 5vw, 4.5rem);
  }
  .founder-quote__mark {
    position: absolute;
    left: -0.2rem;
    top: -2.5rem;
    font-family: var(--font-headline);
    font-size: clamp(6rem, 14vw, 11rem);
    line-height: 1;
    color: var(--color-signal);
    opacity: 0.35;
    pointer-events: none;
    user-select: none;
  }
  .founder-quote__body p {
    font-family: var(--font-headline);
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.35;
    color: var(--color-bone);
    margin: 0;
    font-weight: 400;
  }
  .founder-quote__body em {
    font-style: italic;
    color: var(--color-signal);
  }
  .founder-quote__cite {
    margin-top: var(--space-2xl);
    padding-left: clamp(2.5rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .founder-quote__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-bone);
    font-weight: 600;
  }
  .founder-quote__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-fog);
  }

  @media (max-width: 600px) {
    .founder-quote {
      padding: var(--space-2xl) 0;
    }
    .founder-quote__body,
    .founder-quote__cite {
      padding-left: var(--space-lg);
    }
    .founder-quote__mark {
      top: -1.8rem;
      left: -0.1rem;
    }
  }

  /* ── Cooperative Model section ──────────────────────────── */
  .coop__header {
    max-width: 64ch;
    margin-bottom: var(--space-3xl);
  }
  .coop__title {
    margin-top: var(--space-md);
    text-align: left;
  }
  .coop__lede {
    margin-top: var(--space-lg);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-fog);
    max-width: 56ch;
  }

  .coop__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--space-2xl), 5vw, var(--space-3xl));
    align-items: start;
  }

  /* Pillar shared */
  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .pillar__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(232, 226, 217, 0.12);
    margin-bottom: var(--space-xl);
  }
  .pillar__num {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-wire);
    letter-spacing: -0.02em;
  }
  .pillar__cat {
    font-family: var(--font-mono);
    font-size: var(--text-micro); /* 13px — mobile-safe */
    text-transform: uppercase;
    letter-spacing: var(--tracking-mega);
    color: var(--color-fog);
  }
  .pillar__title {
    font-family: var(--font-headline);
    font-size: clamp(1.875rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: var(--color-bone);
    margin: 0;
  }
  .pillar__body {
    margin-top: var(--space-xl);
    color: var(--color-fog);
  }
  .pillar__body p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
  }
  .pillar__body p + p {
    margin-top: var(--space-md);
  }
  .pillar__body strong {
    color: var(--color-bone);
    font-weight: 600;
  }

  /* Co-Chair diagram (Pillar 01) */
  .cochair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid rgba(232, 226, 217, 0.08);
    border-bottom: 1px solid rgba(232, 226, 217, 0.08);
    min-height: 180px;
  }
  .cochair__node {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-lg);
    border: 1px solid rgba(232, 226, 217, 0.15);
    background: rgba(232, 226, 217, 0.03);
    text-align: center;
    transition: border-color var(--duration-base), background var(--duration-base);
  }
  .cochair__node:hover {
    border-color: var(--color-wire);
    background: rgba(200, 168, 78, 0.06);
  }
  .cochair__role {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-bone);
  }
  .cochair__desc {
    font-family: var(--font-mono);
    font-size: var(--text-micro); /* 13px — was 0.7rem (~11px), below a11y floor */
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fog);
  }
  .cochair__pivot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 80px;
  }
  .cochair__pivot-rule {
    width: 1px;
    height: 12px;
    background: var(--color-wire);
  }
  .cochair__pivot-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro); /* 13px — was 0.7rem */
    text-transform: uppercase;
    letter-spacing: var(--tracking-mega);
    color: var(--color-wire);
    white-space: nowrap;
  }

  /* 50/50 Split bar (Pillar 02) */
  .splitbar {
    margin-top: var(--space-xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid rgba(232, 226, 217, 0.08);
    border-bottom: 1px solid rgba(232, 226, 217, 0.08);
  }
  .splitbar__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 96px;
    border: 1px solid rgba(232, 226, 217, 0.15);
    overflow: hidden;
  }
  .splitbar__seg {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }
  .splitbar__seg--ubfsf {
    background: var(--color-wire);
    color: var(--color-void);
  }
  .splitbar__seg--coop {
    background: transparent;
    color: var(--color-bone);
    border-left: 1px solid rgba(232, 226, 217, 0.15);
  }
  .splitbar__pct {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1;
    font-weight: 400;
  }
  .splitbar__legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }
  .splitbar__key {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro); /* 13px — was 0.7rem */
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fog);
    line-height: 1.3;
  }
  .splitbar__swatch {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    border: 1px solid rgba(232, 226, 217, 0.2);
  }
  .splitbar__swatch--ubfsf { background: var(--color-wire); border-color: var(--color-wire); }
  .splitbar__swatch--coop { background: transparent; }

  /* Responsive */
  @media (max-width: 900px) {
    .coop__grid {
      grid-template-columns: 1fr;
      gap: var(--space-3xl);
    }
    .cochair {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .cochair__pivot {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-sm);
    }
    .cochair__pivot-rule {
      width: 24px;
      height: 1px;
    }
  }
  @media (max-width: 500px) {
    .splitbar__legend {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }

  /* ───────────────────────────────────────────────────────────
   * Cooperative model — scroll-triggered animation
   *
   * Split-bar fill is the WHY: it visually proves the 50/50 split.
   * Co-Chair diagram fades in gently (no decorative slide-in — the
   * static diagram already communicates the structure).
   * ─────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {

    /* --- Pillar 01 — Co-Chair: simple in-place fade --- */
    .coop[data-coop-reveal] .cochair {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: 100ms;
    }
    .coop[data-coop-reveal].is-revealing .cochair {
      opacity: 1;
      transform: translateY(0);
    }

    /* --- Pillar 02 — Split bar: PURPOSEFUL data viz --- */
    .coop[data-coop-reveal] .splitbar__row {
      position: relative;
      overflow: hidden;
    }
    /* Each segment starts at 0 width, fills to 50% */
    .coop[data-coop-reveal] .splitbar__seg--ubfsf {
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: 300ms;
    }
    .coop[data-coop-reveal] .splitbar__seg--coop {
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: 600ms;
    }
    /* Percentage text fades in as bars complete */
    .coop[data-coop-reveal] .splitbar__seg--ubfsf .splitbar__pct {
      opacity: 0;
      transition: opacity 0.4s ease-out;
      transition-delay: 700ms;
    }
    .coop[data-coop-reveal] .splitbar__seg--coop .splitbar__pct {
      opacity: 0;
      transition: opacity 0.4s ease-out;
      transition-delay: 1000ms;
    }
    .coop[data-coop-reveal] .splitbar__legend {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.5s ease-out,
        transform 0.5s ease-out;
      transition-delay: 1250ms;
    }

    .coop[data-coop-reveal].is-revealing .splitbar__seg--ubfsf,
    .coop[data-coop-reveal].is-revealing .splitbar__seg--coop {
      transform: scaleX(1);
    }
    .coop[data-coop-reveal].is-revealing .splitbar__pct { opacity: 1; }
    .coop[data-coop-reveal].is-revealing .splitbar__legend {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
