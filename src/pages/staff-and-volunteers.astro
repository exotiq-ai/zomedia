---
import { getCollection } from 'astro:content';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import TeamCard from '../components/content/TeamCard.astro';

const title = "Staff & Volunteers";
const description = "Meet the team behind Zo Media Productions: a cooperative model where every position is co-held by inside and outside members.";
const breadcrumbs = [{ label: "Staff & Volunteers" }];

const team = (await getCollection('team'))
  .filter((m) => m.data.category === 'staff' || m.data.category === 'volunteer')
  .sort((a, b) => a.data.order - b.data.order);
---

<SubpageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hero hero--editorial hero--editorial-compact">
    <div class="container container--narrow">
      <h1 class="hero__headline">Staff & Volunteers</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <p class="text-lg">
        Zo Media Productions operates on a co-chair model rooted in equity and collaboration. Every leadership position is co-held by an inside member (someone who is currently incarcerated) and an outside member, typically a student volunteer. This structure ensures that the people closest to the stories being told have a direct hand in shaping how they reach the world.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeader title="The Team" />
      <div class="team-list mt-xl">
        {team.map((member) => (
          <TeamCard
            name={member.data.name}
            role={member.data.role}
            photo={member.data.photo}
            bio={member.data.bio}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow text-center">
      <p class="text-lg">
        Want to volunteer your time or expertise? We are always looking for people who believe in second chances.
      </p>
      <a href="/contact/" class="btn btn--outline btn--lg mt-lg">Get Involved</a>
    </div>
  </section>
</SubpageLayout>
