---
import { getCollection } from 'astro:content';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const title = "Special Projects";
const description = "Independent projects exploring the intersection of incarceration, art, and justice.";
const breadcrumbs = [{ label: "Special Projects" }];

// Projects are managed in the CMS (Sanity → Special Projects). A project with status "Active" and a link
// is live; the first live one is featured at the top, the rest appear in the row below.
const projects = (await getCollection('projects'))
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => a.order - b.order);

const isLive = (p: (typeof projects)[number]) => p.status === 'active' && Boolean(p.externalUrl);
const featured = projects.find(isLive);
const rest = projects.filter((p) => p !== featured);

const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<SubpageLayout ogImage="/assets/og/special-projects.jpg" title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hero hero--editorial" style="--hero-image: url('/assets/images/zo-media/folsom-tower.jpeg'); --hero-image-position: center 30%; --hero-overlay: 0.85;">
    <div class="hero__inner">
      <span class="hero__eyebrow">Initiatives</span>
      <h1 class="hero__headline">Special Projects</h1>
      <p class="hero__subhead">Independent projects exploring the intersection of incarceration, art, and justice.</p>
    </div>
  </section>

  {featured && (
    <section class="section" aria-labelledby="featured-title">
      <div class="container reveal">
        <article class="featured">
          <div class="featured__logo">
            {featured.heroImage ? (
              <img src={featured.heroImage} alt={`${featured.title} logo`} width="1192" height="613" decoding="async" fetchpriority="high" />
            ) : (
              <span class="featured__logo-text" aria-hidden="true">{featured.title}</span>
            )}
          </div>
          <div class="featured__body">
            <span class="featured__badge"><span class="featured__badge-dot" aria-hidden="true"></span>Now live</span>
            <h2 id="featured-title" class="featured__title">{featured.title}</h2>
            <p class="featured__tagline">{featured.tagline}</p>
            <p class="featured__text">{featured.description}</p>
            <a href={featured.externalUrl} class="btn btn--primary btn--lg featured__cta" target="_blank" rel="noopener">
              Visit {hostOf(featured.externalUrl!)} <span aria-hidden="true">&nearr;</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        </article>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="section section--alt" aria-labelledby="upcoming-title">
      <div class="container reveal">
        <SectionHeader eyebrow="Coming Next" title="In Production" align="center" />
        <div class="grid grid--3 grid--stack-tablet mt-2xl" id="upcoming-title">
          {rest.map((p) => {
            const live = isLive(p);
            const Tag = live ? 'a' : 'article';
            return (
              <Tag
                class:list={['project', live && 'project--live']}
                {...(live ? { href: p.externalUrl, target: '_blank', rel: 'noopener' } : {})}
              >
                <h3 class="project__title">{p.title}</h3>
                <p class="project__tagline">{p.tagline}</p>
                <span class="project__status">
                  {live ? (<>Visit project <span aria-hidden="true">&nearr;</span></>) : (<><span class="project__tick" aria-hidden="true"></span>In production</>)}
                </span>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}
</SubpageLayout>

<style>
  /* ── Featured project ─────────────────────────────────────── */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    border: 1px solid var(--color-border-emphasis);
    border-top: 2px solid var(--color-signal);
    background: var(--color-graphite);
    overflow: hidden;
  }
  .featured__logo {
    display: grid;
    place-items: center;
    background: #050505; /* matches the logo artwork's own background (rgb 5,5,5) so no box shows */
    padding: var(--space-2xl);
    min-height: 20rem;
  }
  .featured__logo img { width: 100%; max-width: 30rem; height: auto; display: block; }
  .featured__logo-text {
    font-family: var(--font-headline);
    font-size: var(--text-h2);
    color: var(--color-bone);
    text-align: center;
  }
  .featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-2xl);
  }
  .featured__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    color: var(--color-success);
  }
  .featured__badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    animation: featured-pulse 2.4s ease-in-out infinite;
  }
  @keyframes featured-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .featured__title { font-size: var(--text-h1); line-height: 1.05; }
  .featured__tagline {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: var(--text-body-lg);
    color: var(--color-wire);
  }
  .featured__text { color: var(--color-chalk); line-height: var(--leading-loose); max-width: 52ch; }
  .featured__cta { margin-top: var(--space-md); }

  /* ── Upcoming projects: simple cards ──────────────────────── */
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--color-graphite);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-border-emphasis);
    color: inherit;
    text-decoration: none;
    min-height: 12rem;
  }
  .project--live { border-top-color: var(--color-signal); transition: transform var(--duration-fast) var(--ease-snap), border-color var(--duration-fast); }
  .project--live:hover { transform: translateY(-3px); border-color: var(--color-border-emphasis); }
  .project__title { font-size: var(--text-h3); line-height: 1.15; }
  .project__tagline { color: var(--color-fog); font-size: var(--text-small); line-height: 1.55; }
  .project__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-signal-text);
  }
  .project__tick {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal);
    animation: featured-pulse 2.4s ease-in-out infinite;
  }

  @media (max-width: 480px) {
    .featured__cta { width: 100%; font-size: var(--text-micro); letter-spacing: 0.04em; padding-inline: var(--space-md); }
  }
  @media (max-width: 900px) {
    .featured { grid-template-columns: minmax(0, 1fr); }
    .featured__logo { min-height: 0; padding: var(--space-xl); }
    .featured__body { padding: var(--space-xl); }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured__badge-dot, .project__tick { animation: none; }
    .project--live:hover { transform: none; }
  }
</style>
