---
import SubpageLayout from '../layouts/SubpageLayout.astro';

const title = "Special Projects";
const description = "Independent projects exploring the intersection of incarceration, art, and justice.";
const breadcrumbs = [{ label: "Special Projects" }];

const projects = [
  {
    title: "The Global Impact of Mass Incarceration",
    tagline: "Examining how American incarceration policy echoes worldwide",
    gradient: "linear-gradient(135deg, var(--color-graphite), var(--color-signal-dim))",
    illustration: "global-impact.svg",
    href: null,
  },
  {
    title: "Voices On Death Row",
    tagline: "First-person accounts from America's death rows",
    gradient: "linear-gradient(135deg, var(--color-graphite), #1a3a4a)",
    illustration: "voices-death-row.svg",
    href: null,
  },
  {
    title: "Tales From the Zo",
    tagline: "Stories from inside Zo Media's creative community",
    gradient: "linear-gradient(135deg, var(--color-graphite), var(--color-wire-dim))",
    illustration: "tales-from-the-zo.svg",
    href: null,
  },
  {
    title: "Writing Beyond the Prison: Reimagining the Carceral Ecosystem",
    tagline: "Challenging the boundaries of prison literature",
    gradient: "linear-gradient(135deg, var(--color-graphite), #2a1a3a)",
    illustration: "writing-beyond.svg",
    href: null,
  },
];
---

<SubpageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hero hero--editorial" style="--hero-image: url('/assets/images/zo-media/folsom-tower.jpeg'); --hero-image-position: center 30%; --hero-overlay: 0.85;">
    <div class="hero__inner">
      <span class="hero__eyebrow">INITIATIVES</span>
      <h1 class="hero__headline">Special Projects</h1>
      <p class="hero__subhead">Independent projects exploring the intersection of incarceration, art, and justice. Each is a standalone initiative in development.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2 reveal--stagger reveal">
        {projects.map((project) => (
          project.href ? (
            <a href={project.href} class="project-card halftone" style={`background: ${project.gradient};`}>
              <img class="project-card__illustration" src={`/assets/illustrations/${project.illustration}`} alt="" width="140" height="140" loading="lazy" />
              <h2 class="project-card__title">{project.title}</h2>
              <p class="project-card__tagline">{project.tagline}</p>
              <span class="btn btn--outline btn--sm project-card__cta">
                Visit Project &rarr;
              </span>
            </a>
          ) : (
            <article class="project-card project-card--coming-soon halftone" style={`background: ${project.gradient};`} aria-label={`${project.title} (coming soon)`}>
              <img class="project-card__illustration" src={`/assets/illustrations/${project.illustration}`} alt="" width="140" height="140" loading="lazy" />
              <h2 class="project-card__title">{project.title}</h2>
              <p class="project-card__tagline">{project.tagline}</p>
              <span class="project-card__badge">
                <span class="project-card__badge-tick" aria-hidden="true"></span>
                In Production
              </span>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow text-center">
      <p class="project-card__footnote">
        These are independent projects in development. Public details and external links will be added as each project launches.
      </p>
    </div>
  </section>
</SubpageLayout>

<style>
  .project-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform var(--duration-base), box-shadow var(--duration-base);
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }
  .project-card__illustration {
    align-self: flex-start;
    width: 96px;
    height: 96px;
    margin-bottom: auto;
    color: var(--color-bone);
    opacity: 0.78;
    transition: opacity var(--duration-normal) var(--ease-snap), transform var(--duration-normal) var(--ease-snap);
  }
  .project-card:hover .project-card__illustration {
    opacity: 1;
    transform: translateY(-2px) scale(1.04);
  }
  .project-card__title {
    font-family: var(--font-headline);
    font-size: var(--text-2xl);
    color: var(--color-bone);
    margin-bottom: var(--space-sm);
    line-height: 1.2;
  }
  .project-card__tagline {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-bone); /* was --color-fog — failed contrast on lighter gradients */
    opacity: 0.85;
    margin-bottom: var(--space-lg);
  }
  .project-card__cta {
    align-self: flex-start;
  }
  /* Letterpress-style stamp — signal-red outline, mono, slight off-axis rotation.
   * Sits like a wet-ink mark applied at the press. */
  .project-card__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mega);
    color: var(--color-signal);
    background: rgba(10, 10, 11, 0.4);
    padding: 0.4rem 0.7rem;
    border: 1.5px solid var(--color-signal);
    border-radius: 2px;
    font-weight: 700;
    transform: rotate(-2deg);
    transform-origin: left center;
    box-shadow:
      0.5px 0.5px 0 rgba(214, 64, 69, 0.2),
      1.5px 1.5px 0 rgba(214, 64, 69, 0.1);
    transition: transform var(--duration-fast) var(--ease-snap);
  }
  .project-card:hover .project-card__badge {
    transform: rotate(-1deg);
  }
  .project-card__badge-tick {
    width: 5px;
    height: 5px;
    background: var(--color-signal);
    border-radius: 50%;
    flex-shrink: 0;
    animation: card-badge-pulse 2.4s ease-in-out infinite;
  }
  @keyframes card-badge-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card__badge-tick { animation: none; }
  }
  .project-card__footnote {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-fog);
    letter-spacing: var(--tracking-wide);
    max-width: 48ch;
    margin-inline: auto;
  }
</style>
