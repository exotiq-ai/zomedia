---
import { getCollection } from 'astro:content';
import SubpageLayout from '../layouts/SubpageLayout.astro';

const bookEntries = await getCollection('books');
const books = bookEntries
  .map((entry) => entry.data)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
---

<SubpageLayout title="Books" description="Literature by incarcerated voices: memoir, essays, poetry, and anthologies." breadcrumbs={[{ label: "Books" }]}>

  <section class="hero hero--editorial hero--editorial-compact">
    <div class="hero__inner">
      <h1 class="hero__headline">Books</h1>
      <p class="hero__subhead">Literature by incarcerated voices: memoir, essays, poetry, and anthologies.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-bar" role="group" aria-label="Filter books by category">
        <button class="filter-pill active" data-filter="all" aria-pressed="true">All</button>
        <button class="filter-pill" data-filter="memoir" aria-pressed="false">Memoir</button>
        <button class="filter-pill" data-filter="essays" aria-pressed="false">Essays</button>
        <button class="filter-pill" data-filter="poetry" aria-pressed="false">Poetry</button>
        <button class="filter-pill" data-filter="anthology" aria-pressed="false">Anthology</button>
      </div>
      <div id="book-filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>

      <div class="grid grid--3 book-grid">
        {books.map((book) => (
          <article class="card card--feature book-card" data-category={book.category}>
            <div class="book-card__cover img-editorial">
              <img
                src={book.coverImage}
                alt={`${book.title} cover`}
                loading="lazy"
                decoding="async"
                width="400"
                height="600"
              />
            </div>
            <div class="book-card__body">
              <span class="eyebrow">
                {book.category}
                {book.isForthcoming && <> &middot; Forthcoming</>}
              </span>
              <h3 class="card__title">{book.title}</h3>
              <p class="book-card__author">{book.author}</p>
              <p class="card__text">{book.description}</p>
              <div class="book-card__prices">
                {book.priceHardcover && <span class="book-card__price">Print: {book.priceHardcover}</span>}
                {book.priceEbook && <span class="book-card__price">eBook: {book.priceEbook}</span>}
              </div>
              {book.purchaseUrl ? (
                <a class="btn btn--primary btn--sm" href={book.purchaseUrl} rel="noopener">
                  {book.isForthcoming ? 'Pre-Order' : 'Add to Cart'}
                </a>
              ) : (
                <button class="btn btn--primary btn--sm" type="button" disabled={book.isForthcoming}>
                  {book.isForthcoming ? 'Coming Soon' : 'Add to Cart'}
                </button>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</SubpageLayout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }
  .filter-pill {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-ash);
    border-radius: 2px;
    background: transparent;
    color: var(--color-fog);
    cursor: pointer;
    transition: all var(--duration-fast);
  }
  .filter-pill:hover {
    border-color: var(--color-wire);
    color: var(--color-wire);
  }
  .filter-pill.active {
    background: var(--color-wire);
    border-color: var(--color-wire);
    color: var(--color-void);
  }
  .book-grid {
    row-gap: var(--space-3xl);
  }
  .book-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .book-card__cover {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 2px;
  }
  .book-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .book-card__author {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-fog);
  }
  .book-card__prices {
    display: flex;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-chalk);
    margin-top: var(--space-xs);
  }
  .book-card__price {
    white-space: nowrap;
  }
  .book-card .btn {
    margin-top: var(--space-sm);
    align-self: flex-start;
  }
  .book-card.hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .grid--3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .grid--3 { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.book-card');
    const liveRegion = document.getElementById('book-filter-status');

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-pressed', 'true');

        const filter = pill.dataset.filter;
        let visible = 0;
        cards.forEach(card => {
          const match = filter === 'all' || card.dataset.category === filter;
          card.classList.toggle('hidden', !match);
          if (match) visible++;
        });

        if (liveRegion) {
          const label = filter === 'all' ? 'all books' : `${filter} books`;
          liveRegion.textContent = `Showing ${visible} ${label}.`;
        }
      });
    });
  });
</script>
