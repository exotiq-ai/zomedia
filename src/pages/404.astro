---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="hero hero--editorial hero--editorial-center">
    <div class="hero__inner">
      <span class="hero__eyebrow">404</span>
      <h1 class="hero__headline">Page Not Found</h1>
      <p class="hero__subhead">The page you're looking for doesn't exist or has been moved.</p>
      <div class="hero__ctas">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/contact/" class="btn btn--outline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
