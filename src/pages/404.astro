---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="hero hero--minimal" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div class="hero__inner" style="display: flex; flex-direction: column; align-items: center;">
      <span class="label">404</span>
      <h1 class="hero__headline">Page Not Found</h1>
      <p class="hero__subhead" style="margin-inline: auto;">The page you're looking for doesn't exist or has been moved.</p>
      <div class="hero__ctas">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/contact/" class="btn btn--outline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
