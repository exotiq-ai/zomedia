---
import SubpageLayout from '../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Contact Us" breadcrumbs={[{ label: "Contact Us" }]}>
  <section class="contact-hero">
    <div class="contact-hero__inner">
      <h1 class="hero__headline">Get In Touch</h1>
      <p class="hero__subhead">Questions, partnerships, press inquiries, or just want to say what's up — we're here.</p>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="grid grid--asymmetric">
        <!-- Contact Form -->
        <div>
          <h2>Send a Message</h2>
          <form data-netlify="true" netlify-honeypot="bot-field" name="contact" method="POST" style="margin-top: var(--space-xl);">
            <input type="hidden" name="form-name" value="contact" />
            <p class="sr-only"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" name="name" required class="form-control" placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" required class="form-control" placeholder="your@email.com" />
            </div>
            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <select id="subject" name="subject" required class="form-control">
                <option value="" disabled selected>Select a topic</option>
                <option value="general">General Inquiry</option>
                <option value="press">Press / Media</option>
                <option value="partnership">Partnership</option>
                <option value="submission">Creative Submission</option>
                <option value="support">Donations / Support</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea id="message" name="message" required class="form-control" rows="6" placeholder="What's on your mind?"></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--lg" style="margin-top: var(--space-md);">Send Message</button>
          </form>
        </div>

        <!-- Contact Info Card -->
        <div>
          <div class="card" style="padding: var(--space-2xl);">
            <div class="signal-line"></div>
            <h3 class="card__title">Contact Information</h3>
            <div style="margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-lg);">
              <div>
                <span class="label" style="color: var(--color-wire);">Mailing Address</span>
                <p style="margin-top: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-sm);">
                  Zo Media Productions<br />
                  P.O. Box 862<br />
                  Bristow, OK 74010
                </p>
              </div>
              <div>
                <span class="label" style="color: var(--color-wire);">Phone</span>
                <p style="margin-top: var(--space-xs);">
                  <a href="tel:+14158023147" class="strike-hover" style="font-family: var(--font-mono); font-size: var(--text-sm);">1-415-802-3147</a>
                </p>
              </div>
              <div>
                <span class="label" style="color: var(--color-wire);">Email</span>
                <p style="margin-top: var(--space-xs);">
                  <a href="mailto:info@zomediaproductions.com" class="strike-hover" style="font-family: var(--font-mono); font-size: var(--text-sm);">info@zomediaproductions.com</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</SubpageLayout>

<style>
  .contact-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: flex-end;
    background: url('/assets/images/zo-media/zo-tower.001.jpeg') center/cover no-repeat;
  }
  .contact-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 11, 0.5) 0%,
      rgba(10, 10, 11, 0.9) 100%
    );
  }
  .contact-hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3xl) var(--grid-margin) var(--space-2xl);
    width: 100%;
  }
</style>
