---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<SubpageLayout title="Contact Us" breadcrumbs={[{ label: "Contact Us" }]}>
  <section
    class="hero hero--editorial hero--editorial-compact"
    style="--hero-image: url('/assets/images/zo-media/zo-tower.001.jpeg'); --hero-overlay: 0.7;"
  >
    <div class="hero__inner">
      <h1 class="hero__headline">Get In Touch</h1>
      <p class="hero__subhead">Questions, partnerships, press inquiries, or just want to say what's up? We're here.</p>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="grid grid--asymmetric">
        <!-- Contact Form -->
        <div>
          <SectionHeader title="Send a Message" />
          <!--
            Netlify Forms captures every named field automatically (including
            inquiry-type). Configure notification routing in the Netlify
            dashboard (Forms → Settings → Form notifications) to forward each
            inquiry-type value to the right inbox — no routing logic needed in
            code here.
          -->
          <form data-netlify="true" netlify-honeypot="bot-field" name="contact" method="POST" class="contact-form mt-xl">
            <input type="hidden" name="form-name" value="contact" />
            <p class="sr-only"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" name="name" required class="form-control" placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" required class="form-control" placeholder="your@email.com" />
            </div>
            <div class="form-group">
              <label for="organization" class="form-label">Organization <span class="form-label__optional">(optional)</span></label>
              <input type="text" id="organization" name="organization" class="form-control" placeholder="Company, studio, or affiliation" />
            </div>
            <div class="form-group">
              <label for="inquiry-type" class="form-label">Inquiry Type</label>
              <select id="inquiry-type" name="inquiry-type" required class="form-control">
                <option value="" disabled selected>Select an inquiry type</option>
                <option value="general">General Inquiry</option>
                <option value="film">Film Collaboration</option>
                <option value="book">Book / Publishing Inquiry</option>
                <option value="donation">Donation / Sponsorship</option>
                <option value="press">Press / Media</option>
              </select>
            </div>
            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <input type="text" id="subject" name="subject" required class="form-control" placeholder="A short summary" />
            </div>
            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea id="message" name="message" required class="form-control" rows="6" placeholder="What's on your mind?"></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--lg mt-md">Send Message</button>
          </form>
        </div>

        <!-- Contact Info Card -->
        <div>
          <div class="card contact-info-card">
            <div class="signal-line"></div>
            <h3 class="card__title">Contact Information</h3>
            <div class="contact-info-list">
              <div class="contact-info__row">
                <span class="eyebrow">Mailing Address</span>
                <p class="contact-info__text mt-xs">
                  Zo Media Productions<br />
                  P.O. Box 862<br />
                  Bristow, OK 74010
                </p>
              </div>
              <div class="contact-info__row">
                <span class="eyebrow">Phone</span>
                <p class="mt-xs">
                  <a href="tel:+19189245872" class="strike-hover contact-info__link">1-918-924-5872</a>
                </p>
              </div>
              <div class="contact-info__row">
                <span class="eyebrow">Email</span>
                <p class="mt-xs">
                  <a href="mailto:info@zomediaproductions.com" class="strike-hover contact-info__link">info@zomediaproductions.com</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</SubpageLayout>

<style>
  .contact-info-card {
    padding: var(--space-2xl);
  }
  .contact-info-list {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .contact-info__text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .contact-info__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .form-label__optional {
    color: var(--color-ash);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
</style>

<script>
  /**
   * Pre-select the Inquiry Type dropdown from a URL query param.
   * Accepts ?type=film, ?type=book, ?type=donation, ?type=press,
   * ?type=general — also accepts ?intent= as a legacy alias used by
   * the donate buttons on /support/.
   */
  function preselectInquiryType() {
    const select = document.getElementById('inquiry-type') as HTMLSelectElement | null;
    if (!select) return;
    const params = new URLSearchParams(window.location.search);
    const raw = (params.get('type') || params.get('intent') || '').toLowerCase().trim();
    if (!raw) return;

    const alias: Record<string, string> = {
      film: 'film',
      films: 'film',
      collab: 'film',
      collaboration: 'film',
      book: 'book',
      books: 'book',
      publishing: 'book',
      donate: 'donation',
      donation: 'donation',
      sponsor: 'donation',
      sponsorship: 'donation',
      support: 'donation',
      press: 'press',
      media: 'press',
      general: 'general',
    };

    const target = alias[raw];
    if (!target) return;
    const match = Array.from(select.options).find((o) => o.value === target);
    if (match) {
      select.value = target;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  preselectInquiryType();
  document.addEventListener('astro:page-load', preselectInquiryType);
</script>
