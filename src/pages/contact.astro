---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<SubpageLayout title="Contact Us" breadcrumbs={[{ label: "Contact Us" }]}>
  <section
    class="hero hero--editorial hero--editorial-compact"
    style="--hero-image: url('/assets/images/zo-media/zo-tower.001.jpeg'); --hero-overlay: 0.7;"
  >
    <div class="hero__inner">
      <h1 class="hero__headline">Get In Touch</h1>
      <p class="hero__subhead">Questions, partnerships, press inquiries, or just want to say what's up — we're here.</p>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="grid grid--asymmetric">
        <!-- Contact Form -->
        <div>
          <SectionHeader title="Send a Message" />
          <form data-netlify="true" netlify-honeypot="bot-field" name="contact" method="POST" class="contact-form mt-xl">
            <input type="hidden" name="form-name" value="contact" />
            <p class="sr-only"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" name="name" required class="form-control" placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" required class="form-control" placeholder="your@email.com" />
            </div>
            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <select id="subject" name="subject" required class="form-control">
                <option value="" disabled selected>Select a topic</option>
                <option value="general">General Inquiry</option>
                <option value="press">Press / Media</option>
                <option value="partnership">Partnership</option>
                <option value="submission">Creative Submission</option>
                <option value="support">Donations / Support</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea id="message" name="message" required class="form-control" rows="6" placeholder="What's on your mind?"></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--lg mt-md">Send Message</button>
          </form>
        </div>

        <!-- Contact Info Card -->
        <div>
          <div class="card contact-info-card">
            <div class="signal-line"></div>
            <h3 class="card__title">Contact Information</h3>
            <div class="contact-info-list">
              <div class="contact-info__row">
                <span class="eyebrow">Mailing Address</span>
                <p class="contact-info__text mt-xs">
                  Zo Media Productions<br />
                  P.O. Box 862<br />
                  Bristow, OK 74010
                </p>
              </div>
              <div class="contact-info__row">
                <span class="eyebrow">Phone</span>
                <p class="mt-xs">
                  <a href="tel:+19189245872" class="strike-hover contact-info__link">1-918-924-5872</a>
                </p>
              </div>
              <div class="contact-info__row">
                <span class="eyebrow">Email</span>
                <p class="mt-xs">
                  <a href="mailto:info@zomediaproductions.com" class="strike-hover contact-info__link">info@zomediaproductions.com</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</SubpageLayout>

<style>
  .contact-info-card {
    padding: var(--space-2xl);
  }
  .contact-info-list {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .contact-info__text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .contact-info__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
