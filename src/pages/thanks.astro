---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import { SUBSTACK } from '../config/site';
---

<SubpageLayout
  title="Thank You"
  description="Your submission to Zo Media Productions was received."
  noindex
  breadcrumbs={[{ label: 'Thank You' }]}
>
  <section class="hero hero--editorial hero--editorial-compact">
    <div class="hero__inner">
      <span class="eyebrow eyebrow--signal">Received</span>
      <h1 class="hero__headline">Thank you.</h1>
      <p class="hero__subhead" id="thanks-copy">Your submission reached us. We'll be in touch if a reply is needed.</p>
      <div class="hero__ctas">
        <a id="thanks-substack" href={SUBSTACK.subscribeUrl()} class="btn btn--primary" target="_blank" rel="noopener" hidden>Confirm on Substack &rarr;</a>
        <a href="/" class="btn btn--outline">Back to Home</a>
      </div>
    </div>
  </section>
</SubpageLayout>

<script>
  // Tailor the message to the form that sent the visitor here (?form=contact|newsletter).
  function tailor() {
    const el = document.getElementById('thanks-copy');
    const form = new URLSearchParams(location.search).get('form');
    if (!el) return;
    if (form === 'newsletter') {
      el.textContent = 'Thanks! One last step: confirm your subscription on Substack so new issues reach your inbox.';
      document.getElementById('thanks-substack')?.removeAttribute('hidden');
    }
    if (form === 'contact') el.textContent = "Your message is on its way to our team. We'll reply as soon as we can.";
  }
  document.addEventListener('astro:page-load', tailor);
</script>
