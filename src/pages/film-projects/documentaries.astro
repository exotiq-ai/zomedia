---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Documentaries & Film Shorts" description="Documentary films and short works by incarcerated filmmakers." breadcrumbs={[{ label: "Film Projects", href: "/film-projects/" }, { label: "Documentaries & Film Shorts" }]}>

  <section class="hero hero--editorial hero--editorial-compact">
    <div class="hero__inner">
      <h1 class="hero__headline">Documentaries &amp; Film Shorts</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="card card--quiet coming-soon">
        <span class="eyebrow">Coming Soon</span>
        <p class="text-lg mt-md">Documentary projects coming soon. Zo Media is producing documentary films and short works capturing untold stories from behind the wall.</p>
        <a href="/film-projects/" class="btn btn--outline mt-xl">&larr; Back to Film Projects</a>
      </div>
    </div>
  </section>

</SubpageLayout>

<style>
  .coming-soon {
    text-align: center;
    padding: var(--space-3xl);
  }
</style>
