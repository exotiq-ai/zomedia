---
import { Image } from 'astro:assets';
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import FilmCTA from '../../components/content/FilmCTA.astro';
import ivanPortrait from '../../assets/images/zo-media/ivan-portrait.jpg';
---

<SubpageLayout title="Documentaries & Film Shorts" description="Documentary films and short works by incarcerated filmmakers." breadcrumbs={[{ label: "Film Projects", href: "/film-projects/" }, { label: "Documentaries & Film Shorts" }]}>

  <section class="hero hero--editorial hero--editorial-compact">
    <div class="hero__inner">
      <span class="hero__eyebrow">Documentary &middot; Film Shorts</span>
      <h1 class="hero__headline">Documentaries &amp; Film Shorts</h1>
      <p class="hero__subhead">First-person, unflinching documentary work from incarcerated filmmakers. On the record, on tape.</p>
    </div>
  </section>

  <!-- Featured: Cell Power -->
  <section class="section section--alt">
    <div class="container reveal">
      <header class="film-feature__header">
        <span class="eyebrow eyebrow--signal">Featured Documentary</span>
        <h2 class="film-feature__title">Cell Power</h2>
        <p class="film-feature__deck">Shot on contraband cell phones inside America&rsquo;s prisons, <em>Cell Power</em> tells the raw, uncut reality of life behind bars: sexual assault, guard abuse, murder, all of it.</p>
      </header>

      <figure class="video-frame">
        <div class="video-frame__chrome">
          <span class="video-frame__label">
            <span class="video-frame__dot" aria-hidden="true"></span>
            Now Playing &middot; Cell Power
          </span>
          <span class="video-frame__meta">YT &middot; 0YJZmIHGBXE</span>
        </div>

        <div class="video-frame__stage" data-video-stage data-video-id="0YJZmIHGBXE">
          <button
            type="button"
            class="video-frame__poster"
            data-video-trigger
            aria-label="Play the Cell Power documentary"
          >
            <img
              src="https://img.youtube.com/vi/0YJZmIHGBXE/maxresdefault.jpg"
              alt="Cell Power documentary thumbnail"
              loading="lazy"
              decoding="async"
              width="1280"
              height="720"
            />
            <span class="video-frame__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5v14l11-7z" fill="currentColor" />
              </svg>
            </span>
            <span class="video-frame__strip video-frame__strip--top" aria-hidden="true"></span>
            <span class="video-frame__strip video-frame__strip--bottom" aria-hidden="true"></span>
          </button>
        </div>

        <figcaption class="video-frame__caption">
          Video: Cell Power.
          <noscript>
            <a href="https://www.youtube.com/watch?v=0YJZmIHGBXE" rel="noopener" class="link-underline">Watch on YouTube</a>
          </noscript>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Bio: Ivan Kilgore -->
  <section class="section">
    <div class="container reveal">
      <div class="grid grid--asymmetric director-bio">
        <div class="director-bio__portrait img-editorial">
          <Image
            src={ivanPortrait}
            alt="Ivan Kilgore, author, activist, and founder of the United Black Family Scholarship Foundation"
            widths={[320, 480, 720]}
            sizes="(max-width: 768px) 80vw, 32vw"
            loading="lazy"
            format="webp"
          />
        </div>
        <div class="director-bio__body">
          <span class="eyebrow">About the Director</span>
          <h2 class="director-bio__name">Ivan Kilgore</h2>
          <div class="director-bio__rule" aria-hidden="true"></div>
          <p class="director-bio__lede">
            Author, Activist, and Founder of UBFSF.
          </p>
          <p>
            Ivan Kilgore is an author, activist, and the founder of the United Black Family Scholarship Foundation and Zo Media Productions, LLC. Incarcerated in California for more than two decades, serving a life sentence without the possibility of parole, Ivan discovered his voice as a writer behind prison walls and has spent years leading writing workshops inside the system, empowering others through storytelling and self-expression.
          </p>
          <p>He is the author of four books:</p>
          <ul class="director-bio__books">
            <li><em>Domestic Genocide: The Institutionalization of Society</em></li>
            <li><em>My Comrades&rsquo; Thoughts on Black Lives Matter: A Collection of Essays &amp; Poetry</em></li>
            <li><em>Mayhem, Murder &amp; Magnificence: A Memoir</em></li>
            <li><em>King: The Early Years</em></li>
          </ul>
          <p>
            His writing is required reading at universities across the United States. His story <em>The Zo</em> was adapted into a film by The Marshall Project, winning the 2021 Edward R. Murrow Award for Excellence and Innovation and earning an Emmy nomination in the News &amp; Documentary category.
          </p>
          <p>
            Ivan&rsquo;s reach extends well beyond the page. He regularly lectures at universities in California, New York, New Jersey, Missouri, Florida, Louisiana, and Montreal, and leads internship programs that engage student volunteers in hands-on social justice work.
          </p>
          <div class="director-bio__actions">
            <a href="/books/" class="btn btn--outline">Read the Books</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Status / In Production -->
  <section class="proof">
    <div class="proof__numeral" aria-hidden="true">01</div>
    <div class="proof__inner">
      <span class="proof__stamp">
        <span class="proof__stamp-tick" aria-hidden="true"></span>
        In Production
      </span>
      <h2 class="proof__title">More on the way.</h2>
      <div class="proof__rule" aria-hidden="true"></div>
      <p class="proof__lede">
        Documentaries in development. Tape's rolling, just not finished yet.
      </p>
      <p class="proof__body">
        Zo Media is producing additional documentary films and short works capturing untold stories from behind the wall: first-person, unflinching, on the record.
      </p>
      <dl class="proof__meta">
        <div class="proof__meta-row">
          <dt>Status</dt>
          <dd>Pre-production / capture</dd>
        </div>
        <div class="proof__meta-row">
          <dt>Format</dt>
          <dd>Long-form &middot; Short-form</dd>
        </div>
        <div class="proof__meta-row">
          <dt>Release</dt>
          <dd>To come.</dd>
        </div>
      </dl>
      <div class="proof__ctas">
        <a href="/film-projects/" class="btn btn--outline">&larr; All Film Projects</a>
        <a href="/the-wire/" class="btn btn--primary">Follow on The Wire</a>
      </div>
    </div>
  </section>

  <FilmCTA />

</SubpageLayout>

<style>
  /* ───────────────────────────────────────────────────────────
   * FILM FEATURE — the editorial header above the featured video
   * ─────────────────────────────────────────────────────────── */
  .film-feature__header {
    max-width: 56ch;
    margin-bottom: var(--space-2xl);
  }
  .film-feature__title {
    font-family: var(--font-headline);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: var(--leading-crush);
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: var(--space-md) 0 var(--space-md);
  }
  .film-feature__deck {
    font-family: var(--font-body);
    font-size: clamp(1.3rem, 1rem + 1.15vw, 1.7rem);
    font-weight: 400;
    color: var(--color-bone);
    line-height: 1.5;
    max-width: 54ch;
    margin-top: var(--space-sm);
  }
  .film-feature__deck em {
    font-style: italic;
    color: var(--color-signal);
  }

  /* ───────────────────────────────────────────────────────────
   * VIDEO FRAME — custom editorial chrome around an embed.
   * Lazy load: poster + play button until clicked, then swap
   * in the iframe.
   * ─────────────────────────────────────────────────────────── */
  .video-frame {
    margin: 0;
    background: var(--color-graphite);
    border: 1px solid var(--color-border-emphasis);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .video-frame__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-void);
    border-bottom: 1px solid var(--color-border-emphasis);
  }

  .video-frame__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    color: var(--color-bone);
    font-weight: 600;
  }
  .video-frame__dot {
    width: 8px;
    height: 8px;
    background: var(--color-signal);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(214, 64, 69, 0.18);
    animation: video-frame-pulse 2.4s ease-in-out infinite;
  }
  @keyframes video-frame-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-frame__dot { animation: none; }
  }

  .video-frame__meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    color: var(--color-fog);
    text-transform: uppercase;
  }

  .video-frame__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .video-frame__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
  }
  .video-frame__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.9);
    transition: transform var(--duration-normal) var(--ease-snap), filter var(--duration-normal) var(--ease-snap);
  }
  .video-frame__poster::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,11,0.55) 0%, rgba(10,10,11,0.15) 50%, rgba(10,10,11,0) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .video-frame__poster:hover img,
  .video-frame__poster:focus-visible img {
    transform: scale(1.02);
    filter: contrast(1.08) saturate(1);
  }
  .video-frame__poster:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: -4px;
  }

  .video-frame__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(64px, 10vw, 96px);
    height: clamp(64px, 10vw, 96px);
    background: var(--color-signal);
    color: var(--color-bone);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.5),
      0 0 0 4px rgba(232, 85, 88, 0.18);
    transition:
      transform var(--duration-fast) var(--ease-snap),
      background var(--duration-fast) var(--ease-snap),
      box-shadow var(--duration-fast) var(--ease-snap);
  }
  .video-frame__play svg {
    width: 38%;
    height: 38%;
    margin-left: 8%;
  }
  .video-frame__poster:hover .video-frame__play,
  .video-frame__poster:focus-visible .video-frame__play {
    transform: translate(-50%, -50%) scale(1.06);
    background: var(--color-signal-hot);
    box-shadow:
      0 14px 36px rgba(0, 0, 0, 0.55),
      0 0 0 6px rgba(232, 85, 88, 0.25);
  }

  /* Filmstrip — perforated edges, top/bottom */
  .video-frame__strip {
    position: absolute;
    left: 0;
    right: 0;
    height: 14px;
    background:
      repeating-linear-gradient(
        to right,
        rgba(10, 10, 11, 0.85) 0 14px,
        transparent 14px 24px
      );
    z-index: 2;
    pointer-events: none;
  }
  .video-frame__strip--top { top: 0; }
  .video-frame__strip--bottom { bottom: 0; }

  .video-frame__caption {
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fog);
    background: var(--color-void);
    border-top: 1px solid var(--color-border);
  }
  .video-frame__caption a {
    margin-left: var(--space-sm);
    color: var(--color-bone);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-body);
  }

  /* ───────────────────────────────────────────────────────────
   * DIRECTOR BIO — image left, prose right
   * ─────────────────────────────────────────────────────────── */
  .director-bio {
    align-items: center;
    gap: var(--space-3xl);
  }
  .director-bio__portrait {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-emphasis);
  }
  .director-bio__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .director-bio__body {
    max-width: 56ch;
  }
  .director-bio__name {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: var(--leading-crush);
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: var(--space-md) 0 var(--space-md);
  }
  .director-bio__rule {
    width: 48px;
    height: 3px;
    background: var(--color-signal);
    margin: 0 0 var(--space-lg);
  }
  .director-bio__lede {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: var(--text-body-lg);
    color: var(--color-bone);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-md);
  }
  .director-bio__body p {
    color: var(--color-chalk);
    line-height: var(--leading-loose);
  }
  .director-bio__books {
    margin: var(--space-xs) 0 var(--space-md);
    padding-left: var(--space-lg);
    color: var(--color-chalk);
    line-height: var(--leading-loose);
  }
  .director-bio__books li {
    margin-bottom: var(--space-2xs, 0.25rem);
  }
  .director-bio__actions {
    margin-top: var(--space-xl);
  }

  @media (max-width: 1024px) {
    .director-bio__portrait { max-width: 480px; margin-inline: auto; }
  }

  /* ───────────────────────────────────────────────────────────
   * PROOF — shared "in-development" treatment (status block)
   * ─────────────────────────────────────────────────────────── */
  .proof {
    position: relative;
    background: var(--color-soot);
    padding: var(--space-4xl) var(--grid-margin);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }
  .proof::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.025;
    background-image:
      repeating-linear-gradient(45deg, var(--color-bone) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(-45deg, var(--color-bone) 0 1px, transparent 1px 5px);
    mix-blend-mode: overlay;
    z-index: 0;
  }
  .proof__numeral {
    position: absolute;
    right: -0.08em;
    bottom: -0.18em;
    font-family: var(--font-headline);
    font-size: clamp(14rem, 35vw, 28rem);
    line-height: 0.85;
    font-weight: 400;
    color: var(--color-bone);
    opacity: 0.04;
    letter-spacing: -0.05em;
    user-select: none;
    pointer-events: none;
    z-index: 1;
    white-space: nowrap;
  }

  .proof__inner {
    position: relative;
    z-index: 2;
    max-width: 52rem;
    width: 100%;
  }

  .proof__stamp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    color: var(--color-signal);
    background: transparent;
    border: 1.5px solid var(--color-signal);
    padding: 0.45rem 0.85rem;
    border-radius: 2px;
    font-weight: 700;
    transform: rotate(-1.5deg);
    transform-origin: left center;
    margin-bottom: var(--space-2xl);
    box-shadow:
      0.5px 0.5px 0 rgba(214, 64, 69, 0.15),
      1.5px 1.5px 0 rgba(214, 64, 69, 0.08);
  }
  .proof__stamp-tick {
    width: 6px;
    height: 6px;
    background: var(--color-signal);
    border-radius: 50%;
    flex-shrink: 0;
    animation: proof-pulse 2.4s ease-in-out infinite;
  }

  .proof__title {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: var(--leading-crush);
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: 0 0 var(--space-lg);
    font-weight: 400;
  }

  .proof__rule {
    width: 48px;
    height: 3px;
    background: var(--color-signal);
    margin: 0 0 var(--space-xl);
  }

  .proof__lede {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: var(--leading-tight);
    color: var(--color-bone);
    max-width: 42ch;
    margin: 0 0 var(--space-md);
  }

  .proof__body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-chalk);
    max-width: 56ch;
    margin: 0 0 var(--space-2xl);
  }

  .proof__meta {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border-emphasis);
    margin: 0 0 var(--space-2xl);
    padding-top: var(--space-md);
  }
  .proof__meta-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .proof__meta-row:last-child { border-bottom: none; }
  .proof__meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    color: var(--color-wire);
    font-weight: 600;
    align-self: center;
  }
  .proof__meta dd {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-chalk);
    margin: 0;
    align-self: center;
  }

  .proof__ctas {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  @keyframes proof-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .proof__stamp-tick { animation: none; }
  }

  @media (max-width: 768px) {
    .proof { padding: var(--space-3xl) var(--grid-margin); }
    .proof__numeral { font-size: clamp(14rem, 60vw, 22rem); right: -0.1em; bottom: -0.1em; }
    .proof__meta-row { grid-template-columns: 6rem 1fr; gap: var(--space-sm); }
    .proof__ctas { flex-direction: column; align-items: stretch; }

    .video-frame__chrome { padding: var(--space-sm) var(--space-md); }
    .video-frame__meta { display: none; }
    .director-bio { gap: var(--space-xl); }
  }
</style>

<script>
  function initVideoFrames() {
    const stages = document.querySelectorAll<HTMLElement>('[data-video-stage]');
    stages.forEach((stage) => {
      const trigger = stage.querySelector<HTMLButtonElement>('[data-video-trigger]');
      const videoId = stage.dataset.videoId;
      if (!trigger || !videoId) return;
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';

      trigger.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.title = 'Cell Power documentary';
        iframe.loading = 'lazy';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.setAttribute('allowfullscreen', '');
        iframe.style.position = 'absolute';
        iframe.style.inset = '0';
        iframe.style.width = '100%';
        iframe.style.height = '100%';
        iframe.style.border = '0';
        trigger.replaceWith(iframe);
        iframe.focus();
      });
    });
  }

  initVideoFrames();
  document.addEventListener('astro:page-load', initVideoFrames);
</script>

