---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Documentaries & Film Shorts" description="Documentary films and short works by incarcerated filmmakers." breadcrumbs={[{ label: "Film Projects", href: "/film-projects/" }, { label: "Documentaries & Film Shorts" }]}>

  <section class="hero hero--minimal">
    <div class="container">
      <h1 class="hero__headline">Documentaries & Film Shorts</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="card" style="text-align: center; padding: var(--space-3xl);">
        <span class="label" style="color: var(--color-wire);">Coming Soon</span>
        <p class="text-lg" style="margin-top: var(--space-md);">Documentary projects coming soon. Zo Media is producing documentary films and short works capturing untold stories from behind the wall.</p>
        <a href="/film-projects/" class="btn btn--outline" style="margin-top: var(--space-xl);">&larr; Back to Film Projects</a>
      </div>
    </div>
  </section>

</SubpageLayout>
