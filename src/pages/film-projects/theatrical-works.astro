---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Theatrical Works" description="Stage plays and performances by incarcerated artists." breadcrumbs={[{ label: "Film Projects", href: "/film-projects/" }, { label: "Theatrical Works" }]}>

  <section class="hero hero--editorial hero--editorial-compact">
    <div class="hero__inner">
      <h1 class="hero__headline">Theatrical Works</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="card card--quiet coming-soon">
        <span class="eyebrow">Coming Soon</span>
        <p class="text-lg mt-md">Theatrical works coming soon. Zo Media is producing original stage plays and performances created by incarcerated artists.</p>
        <a href="/film-projects/" class="btn btn--outline mt-xl">&larr; Back to Film Projects</a>
      </div>
    </div>
  </section>

</SubpageLayout>

<style>
  .coming-soon {
    text-align: center;
    padding: var(--space-3xl);
  }
</style>
