---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Amplifying Incarcerated Voices Through Literature, Film & Art">
  <!-- Hero: Split Layout -->
  <section class="hero hero--split">
    <div class="hero__inner">
      <div>
        <span class="hero__eyebrow">A UBFSF 501(c)(3) Cooperative</span>
        <h1 class="hero__headline">The stories that<br />matter most are<br />told from inside.</h1>
        <p class="hero__subhead">Zo Media Productions is a cooperative that publishes literature, produces film, and exhibits art created by incarcerated people — building economic power and driving justice reform from behind the wall.</p>
        <div class="hero__ctas">
          <a href="/books/" class="btn btn--primary btn--lg">Explore the Books</a>
          <a href="/support/" class="btn btn--outline btn--lg">Support the Mission</a>
        </div>
      </div>
      <div class="hero__media img-editorial">
        <img src="/assets/images/zo-media/storefront.jpg" alt="Zo Media Productions storefront" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Mission Pullquote -->
  <section class="section section--alt">
    <div class="container container--narrow text-center reveal">
      <span class="label">Our Mission</span>
      <blockquote class="pullquote" style="border-left: none; text-align: center; padding-inline: 0;">
        We provide the platform for incarcerated talent to produce literature, film, and visual art that drives systemic justice reform. Every story published, every piece exhibited, and every film produced creates both economic opportunity for the creator and a window into a system most Americans never see.
      </blockquote>
    </div>
  </section>

  <!-- Stats / Impact Counter -->
  <section class="section">
    <div class="container text-center reveal">
      <span class="label">Impact</span>
      <h2>By The Numbers</h2>
      <div class="stats" style="margin-top: var(--space-2xl);">
        <div class="stat">
          <span class="stat__number" data-counter data-target="12">0</span>
          <span class="stat__label">Books Published</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="50" data-suffix="%">0%</span>
          <span class="stat__label">Profits to Community</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="100" data-suffix="+">0+</span>
          <span class="stat__label">Incarcerated Creators</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="4">0</span>
          <span class="stat__label">Special Projects</span>
        </div>
      </div>
    </div>
  </section>

  <!-- The Wire Promo -->
  <section class="section section--alt">
    <div class="container reveal">
      <span class="label">The Publication</span>
      <div class="grid grid--asymmetric">
        <div>
          <h2>The Phuckin' Wire</h2>
          <p class="text-lg" style="margin-top: var(--space-lg);">Our flagship newsletter — advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic.</p>
          <a href="/the-wire/" class="btn btn--outline" style="margin-top: var(--space-xl);">Read The Wire</a>
        </div>
        <div class="card halftone" style="text-align: center; padding: var(--space-3xl);">
          <span class="label" style="color: var(--color-signal);">Subscribe</span>
          <p class="card__title">Get every issue delivered.</p>
          <p class="card__text">Stories, investigations, and creative work from inside the system.</p>
          <form data-netlify="true" name="wire-subscribe" method="POST" style="display: flex; gap: var(--space-sm); margin-top: var(--space-lg);">
            <input type="hidden" name="form-name" value="wire-subscribe" />
            <input type="email" name="email" placeholder="your@email.com" required class="form-control" aria-label="Email for The Wire" />
            <button type="submit" class="btn btn--primary">Go</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Books -->
  <section class="section">
    <div class="container reveal">
      <span class="label">From Our Catalog</span>
      <h2 class="text-center">Featured Books</h2>
      <div class="grid grid--2" style="margin-top: var(--space-2xl); gap: var(--space-xl);">
        <div class="card">
          <div class="signal-line"></div>
          <h3 class="card__title">Domestic Genocide: The Institutionalization of Society</h3>
          <p class="card__text">A searing examination of systemic oppression and the institutional structures that perpetuate cycles of incarceration and disenfranchisement in America.</p>
          <a href="/books/" class="btn btn--outline" style="margin-top: var(--space-md);">Learn More</a>
        </div>
        <div class="card">
          <div class="signal-line"></div>
          <h3 class="card__title">King: The Early Years</h3>
          <p class="card__text">An intimate portrait of youth, identity, and the making of a man before the world decided who he should be. Raw, reflective, and unapologetically honest.</p>
          <a href="/books/" class="btn btn--outline" style="margin-top: var(--space-md);">Learn More</a>
        </div>
        <div class="card">
          <div class="signal-line"></div>
          <h3 class="card__title">Mayhem, Murder & Magnificence</h3>
          <p class="card__text">Stories from the edge of survival — where violence, beauty, and resilience collide in the everyday reality of life behind bars.</p>
          <a href="/books/" class="btn btn--outline" style="margin-top: var(--space-md);">Learn More</a>
        </div>
        <div class="card">
          <div class="signal-line"></div>
          <h3 class="card__title">My Comrades' Thoughts</h3>
          <p class="card__text">A collective anthology of poetry, essays, and reflections from incarcerated writers — a chorus of voices demanding to be heard.</p>
          <a href="/books/" class="btn btn--outline" style="margin-top: var(--space-md);">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--alt">
    <div class="container text-center reveal">
      <span class="label">Get Involved</span>
      <h2>Support the movement.</h2>
      <p class="text-lg" style="margin-top: var(--space-md); margin-inline: auto;">Every donation fuels creative work by incarcerated artists and funds the UBFSF Community Grant Fund.</p>
      <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="/support/" class="btn btn--primary btn--lg">Donate Now</a>
        <a href="/contact/" class="btn btn--outline btn--lg">Get In Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="../scripts/counter.ts"></script>
