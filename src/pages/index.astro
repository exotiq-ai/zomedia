---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import heroIvan from '../assets/images/zo-media/hero-ivan.jpg';
import domesticGenocideCover from '../assets/images/zo-media/domestic-genocide-book-cover-adobe.png';
import kingCover from '../assets/images/zo-media/King_frontcover-scaled.jpg';
import mayhemCover from '../assets/images/zo-media/mayhem_murder_and_magnificence.jpg';
import socialJusticeCover from '../assets/images/zo-media/socialjusticeautobiographies_cover-scaled.jpg';
---

<BaseLayout title="Amplifying Incarcerated Voices Through Literature, Film & Art">
  <!-- Hero: Split Layout (home-page exception) — signature reveal moment -->
  <section class="hero hero--split signature-hero" data-signature-hero>
    <div class="hero__inner">
      <div class="signature-hero__copy">
        <span class="hero__eyebrow signature-hero__eyebrow">A UBFSF 501(c)(3) Cooperative</span>
        <h1 class="hero__headline signature-hero__headline" aria-label="The stories that matter most are told from inside.">
          <span class="signature-hero__line" aria-hidden="true">
            <span class="signature-hero__line-inner">The stories that</span>
          </span>
          <span class="signature-hero__line" aria-hidden="true">
            <span class="signature-hero__line-inner">matter most are</span>
          </span>
          <span class="signature-hero__line signature-hero__line--final" aria-hidden="true">
            <span class="signature-hero__line-inner">
              <span class="signature-hero__prefix">told from&nbsp;</span><span class="signature-hero__inside">inside</span><span class="signature-hero__period">.</span>
            </span>
          </span>
        </h1>
        <p class="hero__subhead signature-hero__subhead">Zo Media Productions is a cooperative that publishes literature, produces film, and exhibits art created by incarcerated people &mdash; building economic power and driving justice reform from behind the wall.</p>
        <div class="hero__ctas signature-hero__ctas">
          <a href="/books/" class="btn btn--primary btn--lg signature-hero__cta" data-magnetic>Explore the Books</a>
          <a href="/support/" class="btn btn--outline btn--lg signature-hero__cta" data-magnetic>Support the Mission</a>
        </div>
      </div>
      <div class="hero__media signature-hero__media">
        <Image
          src={heroIvan}
          alt="An incarcerated writer at work — pen to paper, creating from inside"
          widths={[640, 960, 1280, 1920]}
          sizes="(max-width: 1024px) 100vw, 41vw"
          loading="eager"
          fetchpriority="high"
          format="webp"
        />
      </div>
    </div>
  </section>

  <!-- Mission Pullquote -->
  <section class="section section--alt">
    <div class="container container--narrow text-center reveal">
      <span class="eyebrow">Our Mission</span>
      <blockquote class="pullquote pullquote--center">
        We provide the platform for incarcerated talent to produce literature, film, and visual art that drives systemic justice reform. Every story published, every piece exhibited, and every film produced creates both economic opportunity for the creator and a window into a system most Americans never see.
      </blockquote>
    </div>
  </section>

  <!-- Stats / Impact Counter -->
  <section class="section">
    <div class="container reveal">
      <SectionHeader eyebrow="Impact" title="By The Numbers" align="center" />
      <div class="stats mt-2xl">
        <div class="stat">
          <span class="stat__number" data-counter data-target="12">0</span>
          <span class="stat__label">Books Published</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="50" data-suffix="%">0%</span>
          <span class="stat__label">Profits to Community</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="100" data-suffix="+">0+</span>
          <span class="stat__label">Incarcerated Creators</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="4">0</span>
          <span class="stat__label">Special Projects</span>
        </div>
      </div>
    </div>
  </section>

  <!-- The Wire Promo -->
  <section class="section section--alt">
    <div class="container reveal">
      <span class="eyebrow">The Publication</span>
      <div class="grid grid--asymmetric wire-promo__grid mt-lg">
        <div>
          <h2>The Phuckin' Wire</h2>
          <p class="text-lg mt-lg">Our flagship newsletter — advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic.</p>
          <a href="/the-wire/" class="btn btn--outline mt-xl">Read The Wire</a>
        </div>
        <div class="card halftone wire-promo__card">
          <span class="eyebrow eyebrow--signal">Subscribe</span>
          <p class="card__title mt-sm">Get every issue delivered.</p>
          <p class="card__text mt-sm">Stories, investigations, and creative work from inside the system.</p>
          <form data-netlify="true" name="wire-subscribe" method="POST" class="wire-promo__form mt-lg">
            <input type="hidden" name="form-name" value="wire-subscribe" />
            <input type="email" name="email" placeholder="your@email.com" required class="form-control" aria-label="Email for The Wire" />
            <button type="submit" class="btn btn--primary">Go</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Books -->
  <section class="section">
    <div class="container reveal">
      <SectionHeader title="Featured Books" align="center" />
      <div class="grid grid--4 books-grid mt-2xl">
        <a href="/books/" class="book-feature img-editorial">
          <Image
            src={domesticGenocideCover}
            alt="Domestic Genocide book cover"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) 50vw, 25vw"
            loading="lazy"
            format="webp"
          />
          <h3 class="book-feature__title">Domestic Genocide</h3>
        </a>
        <a href="/books/" class="book-feature img-editorial">
          <Image
            src={kingCover}
            alt="King: The Early Years book cover"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) 50vw, 25vw"
            loading="lazy"
            format="webp"
          />
          <h3 class="book-feature__title">King: The Early Years</h3>
        </a>
        <a href="/books/" class="book-feature img-editorial">
          <Image
            src={mayhemCover}
            alt="Mayhem, Murder & Magnificence book cover"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) 50vw, 25vw"
            loading="lazy"
            format="webp"
          />
          <h3 class="book-feature__title">Mayhem, Murder & Magnificence</h3>
        </a>
        <a href="/books/" class="book-feature img-editorial">
          <Image
            src={socialJusticeCover}
            alt="Social Justice Autobiographies book cover"
            widths={[200, 400, 600]}
            sizes="(max-width: 768px) 50vw, 25vw"
            loading="lazy"
            format="webp"
          />
          <h3 class="book-feature__title">Social Justice Autobiographies</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--alt">
    <div class="container text-center reveal">
      <SectionHeader eyebrow="Get Involved" title="Support the movement." align="center" lede="Every donation fuels creative work by incarcerated artists and funds the UBFSF Community Grant Fund." />
      <div class="final-cta__actions mt-xl">
        <a href="/support/" class="btn btn--primary btn--lg">Donate Now</a>
        <a href="/contact/" class="btn btn--outline btn--lg">Get In Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/counter';
  import '../scripts/magnetic';
</script>

<style>
  /* Mission pullquote — centered variant (no left border) */
  .pullquote--center {
    border-left: none;
    text-align: center;
    padding-inline: 0;
  }

  /* The Wire promo grid alignment */
  .wire-promo__grid {
    align-items: center;
  }
  .wire-promo__card {
    text-align: center;
    padding: var(--space-2xl) var(--space-xl);
  }
  .wire-promo__form {
    display: flex;
    gap: var(--space-sm);
  }

  /* Featured Books grid */
  .books-grid {
    gap: var(--space-xl);
  }
  .book-feature {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    aspect-ratio: 2 / 3;
  }
  .book-feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book-feature__title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-lg) var(--space-md);
    background: linear-gradient(to top, rgba(10,10,11,0.9) 0%, transparent 100%);
    font-family: var(--font-headline);
    font-size: var(--text-h3);
    color: var(--color-bone);
    line-height: var(--leading-tight);
  }

  /* Final CTA action row */
  .final-cta__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
