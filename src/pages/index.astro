---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import literatureReading from '../assets/images/zo-media/literature-reading.jpg';
import folsomTower from '../assets/images/zo-media/folsom-tower.jpeg';
import filmYardCrew from '../assets/images/zo-media/film-yard-crew.jpg';
import stageTheatreNeon from '../assets/images/zo-media/stage-theatre-neon.jpg';
import supportWritingSlats from '../assets/images/zo-media/support-writing-slats.jpg';
import phuckinWireMark from '../assets/images/zo-media/phuckin-wire-mark.jpg';

// WHAT WE MAKE — six fronts of the cooperative, in newspaper TOC order.
// Five photo tiles share the duotone treatment (void→bone luminance map);
// the Wire tile uses the native cream+ink Phuckin' Wire mark as a paste-on
// sticker so the brand reads at full fidelity — matches the masthead
// pattern established on /the-wire/.
const tiles = [
  {
    n: '01',
    label: 'Literature',
    kicker: 'Twelve titles in print: memoir, theory, and fiction from inside.',
    href: '/books/',
    photo: {
      src: literatureReading,
      alt: 'A man reads a book in a spartan cell lit by hard window light, seen from behind; quiet, contemplative.',
    },
  },
  {
    n: '02',
    label: 'Film & Documentary',
    kicker: 'Documentary work built around incarcerated subjects and storytellers.',
    href: '/film-projects/documentaries/',
    photo: {
      src: filmYardCrew,
      alt: 'A film crew with a cinema camera and boom mic films a group of incarcerated men standing along a razor-wire prison-yard fence.',
    },
  },
  {
    n: '03',
    label: 'Stage',
    kicker: 'Theatrical works developed from manuscripts written behind the wall.',
    href: '/film-projects/theatrical-works/',
    photo: {
      src: stageTheatreNeon,
      alt: "A vertical neon 'THEATRE' marquee sign glows white against the dark art-deco facade of a downtown building at night.",
    },
  },
  {
    n: '04',
    label: "The Phuckin' Wire",
    kicker: 'The flagship newsletter: advocacy journalism, unfiltered.',
    href: '/the-wire/',
    brand: {
      src: phuckinWireMark,
      alt: "The Phuckin' Wire logo, a wide-eyed face ringed by barbed wire",
    },
  },
  {
    n: '05',
    label: 'Special Projects',
    kicker: 'Original work at the intersection of art, policy, and place.',
    href: '/special-projects/',
    photo: { src: folsomTower, alt: 'A Folsom State Prison guard tower silhouetted against the sky' },
  },
  {
    n: '06',
    label: 'Support the Mission',
    kicker: 'Every gift funds the work and the people doing it.',
    href: '/support/',
    cta: true,
    photo: {
      src: supportWritingSlats,
      alt: 'Weathered hands write a letter in cursive on paper as hard venetian-blind light casts diagonal slats across the page.',
    },
  },
];
---

<BaseLayout title="Amplifying Incarcerated Voices Through Literature, Film & Art">
  {/*
    Duotone filter — defined once, referenced by .tile__media on photo
    tiles. Maps luminance to void→bone with husk-warm midtones so mixed
    photographic sources read as a single editorial set. SVG must precede
    any element that consumes it in the DOM order.
  */}
  <svg width="0" height="0" class="zo-svg-defs" aria-hidden="true" focusable="false">
    <defs>
      <filter id="zo-duotone" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.299 0.587 0.114 0 0
                  0.299 0.587 0.114 0 0
                  0.299 0.587 0.114 0 0
                  0     0     0     1 0" />
        <feComponentTransfer>
          <feFuncR tableValues="0.039 0.910" />
          <feFuncG tableValues="0.039 0.886" />
          <feFuncB tableValues="0.043 0.851" />
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>

  <!-- Hero: Split Layout (home-page exception) — signature reveal moment.
       Each headline line wipes in left-to-right with a slight upward
       drift. The "inside" word gets a signal-red slit + reveal +
       underline as the climactic flourish, then the period types last. -->
  <section class="hero hero--split signature-hero" data-signature-hero>
    <div class="hero__inner">
      <div class="signature-hero__copy">
        <span class="hero__eyebrow signature-hero__eyebrow">A UBFSF 501(c)(3) Cooperative</span>
        <h1 class="hero__headline signature-hero__headline" aria-label="The stories that matter most are told from inside.">
          <span class="signature-hero__line" aria-hidden="true">
            <span class="signature-hero__line-inner">The stories that</span>
          </span>
          <span class="signature-hero__line" aria-hidden="true">
            <span class="signature-hero__line-inner">matter most are</span>
          </span>
          <span class="signature-hero__line signature-hero__line--final" aria-hidden="true">
            <span class="signature-hero__line-inner">
              <span class="signature-hero__prefix">told from&nbsp;</span><span class="signature-hero__inside">inside</span><span class="signature-hero__period">.</span>
            </span>
          </span>
        </h1>
        <p class="hero__subhead signature-hero__subhead">Zo Media Productions is a cooperative that publishes literature, produces film, and exhibits art created by incarcerated people, building economic power and driving justice reform from behind the wall.</p>
        <div class="hero__ctas signature-hero__ctas">
          <a href="/books/" class="btn btn--primary signature-hero__cta" data-magnetic>Explore the Books</a>
          <a href="/support/" class="btn btn--outline signature-hero__cta" data-magnetic>Support the Mission</a>
        </div>
      </div>
      <div class="hero__media signature-hero__media" data-ivan-slot>
        {/*
          Signature hero video — the transparent-typewriter macro clip.
          Per the owner note (see src/assets/images/zo-media/NOTES.md),
          the placeholder image is swapped for an autoplay-muted-loop
          <video> using the same column constraints. Poster paints first
          for a clean LCP; the clip loops silently behind the copy.
        */}
        <video
          class="signature-hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/assets/video/hero-typewriter-poster.jpg"
          aria-label="A Black man's hands typing on a transparent prison typewriter, telling his story from inside"
        >
          <source src="/assets/video/hero-typewriter.webm" type="video/webm" />
          <source src="/assets/video/hero-typewriter.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <!-- Mission Pullquote -->
  <section class="section section--alt">
    <div class="container container--narrow text-center reveal">
      <span class="eyebrow">Our Mission</span>
      <blockquote class="pullquote pullquote--center">
        We provide the platform for incarcerated talent to produce literature, film, and visual art that drives systemic justice reform. Every story published, every piece exhibited, and every film produced creates both economic opportunity for the creator and a window into a system most Americans never see.
      </blockquote>
    </div>
  </section>

  <!-- Two-tone display moment — editorial signature -->
  <section class="section section--flush two-tone-band">
    <div class="container reveal">
      <h2 class="display two-tone two-tone-band__headline">
        <span>We publish</span>
        <span class="two-tone__muted">what the system silences.</span>
      </h2>
    </div>
  </section>

  {/*
    Editorial identity ticker — site voice as a moving editorial band.
    Currently a thematic identity run rather than pull-quotes (the
    cooperative does not yet have a curated pull-quote library). When
    real lines from Wire issues are approved for surface, swap the
    items below for "<quote> — Issue NN" pairs and re-double the set.
  */}
  <div class="ticker" aria-label="Editorial identity band">
    <div class="ticker__track">
      <span class="ticker__item">Voices from inside.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Published by incarcerated creators.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Literature. Film. Art.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Stories the system silences.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Read. Watch. Listen.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      {/* Duplicate set — required for seamless CSS marquee loop */}
      <span class="ticker__item">Voices from inside.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Published by incarcerated creators.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Literature. Film. Art.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Stories the system silences.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
      <span class="ticker__item">Read. Watch. Listen.</span>
      <span class="ticker__divider" aria-hidden="true">✦</span>
    </div>
  </div>

  <!-- Stats / Impact Counter -->
  <section class="section">
    <div class="container reveal">
      <SectionHeader eyebrow="Impact" title="By The Numbers" align="center" />
      <div class="stats mt-2xl">
        <div class="stat">
          <span class="stat__number" data-counter data-target="12">0</span>
          <span class="stat__label">Books Published</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="50" data-suffix="%">0%</span>
          <span class="stat__label">Profits to Community</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="100" data-suffix="+">0+</span>
          <span class="stat__label">Incarcerated Creators</span>
        </div>
        <div class="stat">
          <span class="stat__number" data-counter data-target="4">0</span>
          <span class="stat__label">Special Projects</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE MAKE — six fronts of the cooperative, one editorial wall.
       Sits above the Wire promo so visitors get the table of contents
       (what does Zo do?) BEFORE the subscribe ask — newsletter conversion
       is higher post-orientation, and the Wire is one tile of six, so
       leading with it would create a "Wire, then a grid containing Wire"
       double-take. Soot background gives clean alternating banding
       (stats:void → grid:soot → wire:void → cta:soot). -->
  <section class="section section--alt what-we-make">
    <div class="container reveal">
      <SectionHeader
        eyebrow="What We Make"
        title="Six fronts, one cooperative."
        align="center"
      />
      <div class="what-we-make__grid mt-2xl">
        {tiles.map((t) => (
          <a
            href={t.href}
            class:list={[
              'tile',
              t.photo && 'tile--photo',
              t.brand && 'tile--brand',
              !t.photo && !t.brand && 'tile--type',
              t.cta && 'tile--cta',
            ]}
            aria-label={`${t.label}: ${t.kicker}`}
          >
            {t.photo && (
              <Image
                src={t.photo.src}
                alt={t.photo.alt}
                class="tile__media"
                widths={[400, 600, 900]}
                sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw"
                loading="lazy"
                format="webp"
              />
            )}
            {t.brand && (
              <Image
                src={t.brand.src}
                alt={t.brand.alt}
                class="tile__sticker"
                widths={[280, 420, 560]}
                sizes="(max-width: 600px) 60vw, (max-width: 1024px) 30vw, 20vw"
                loading="lazy"
                format="webp"
              />
            )}
            <span class="tile__arrow" aria-hidden="true">↗ View</span>
            <div class="tile__overlay">
              <span class="tile__label">{t.label}</span>
              <span class="tile__kicker">{t.kicker}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The Wire Promo — the deep dive after the grid TOC. Void background
       so banding alternates cleanly (grid:soot → wire:void → cta:soot). -->
  <section class="section">
    <div class="container reveal">
      <span class="eyebrow">The Publication</span>
      <div class="grid grid--asymmetric wire-promo__grid mt-lg">
        <div>
          <h2>The Phuckin' Wire</h2>
          <p class="text-lg mt-lg">Our flagship newsletter: advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic.</p>
          <a href="/the-wire/" class="btn btn--outline mt-xl">Read The Wire</a>
        </div>
        <div class="card halftone wire-promo__card">
          <span class="eyebrow eyebrow--signal">Request Updates</span>
          <p class="card__title mt-sm">Hear when new work is published.</p>
          <p class="card__text mt-sm">Request publication updates while The Wire's mailing-list service is being finalized.</p>
          <form data-netlify="true" name="wire-updates-interest" method="POST" class="wire-promo__form mt-lg">
            <input type="hidden" name="form-name" value="wire-updates-interest" />
            <input type="email" name="email" placeholder="your@email.com" required class="form-control" aria-label="Email for The Wire" />
            <button type="submit" class="btn btn--primary">Request</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--alt">
    <div class="container text-center reveal">
      <SectionHeader eyebrow="Get Involved" title="Support the movement." align="center" lede="Help advance creator-led literature, film, and art from inside the system." />
      <div class="final-cta__actions mt-xl">
        <a href="/support/" class="btn btn--primary btn--lg">Explore Support Options</a>
        <a href="/contact/" class="btn btn--outline btn--lg">Get In Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/counter';
  import '../scripts/magnetic';
</script>

<style>
  /* Mission pullquote — centered variant (no left border) */
  .pullquote--center {
    border-left: none;
    text-align: center;
    padding-inline: 0;
  }

  /* Two-tone display band — VOTR-style editorial moment.
   * The headline stacks: bone foreground line, husk muted line. */
  .two-tone-band {
    padding-block: var(--space-3xl);
    background: var(--color-void);
    border-top: 1px solid var(--color-border);
  }
  .two-tone-band__headline {
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .two-tone-band__headline span {
    display: block;
  }

  /* Hero video fills the 4:5 split slot the same way the placeholder
   * image did — cover-cropped, focus held slightly high on the hands. */
  .signature-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    display: block;
    filter: contrast(1.05);
  }

  /* The Wire promo grid alignment */
  .wire-promo__grid {
    align-items: center;
  }
  .wire-promo__card {
    text-align: center;
    padding: var(--space-2xl) var(--space-xl);
  }
  .wire-promo__form {
    display: flex;
    gap: var(--space-sm);
  }

  /* ───────────────────────────────────────────────────────────
   * WHAT WE MAKE — six-tile editorial grid (page-scoped).
   *
   * 3×2 uniform square grid. Two visual modes share one overlay system:
   *   .tile--photo : duotoned <Image>, scales on hover
   *   .tile--type  : giant serif numeral on dark gradient (no photo)
   * Hairline gutter (1px on var(--color-border)) gives a broadsheet feel.
   * .tile--cta     : final tile, husk-warm gradient with signal accent
   * ─────────────────────────────────────────────────────────── */
  /* Section bg comes from section--alt (soot) on the parent — see markup.
     Banding plan: stats(void) → grid(soot) → wire(void) → cta(soot). */
  .what-we-make__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  @media (max-width: 1024px) {
    .what-we-make__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .what-we-make__grid { grid-template-columns: 1fr; }
  }

  .tile {
    position: relative;
    aspect-ratio: 1 / 1;
    display: block;
    overflow: hidden;
    /* Graphite (not soot) so tiles stay distinct from the soot section
       frame around them. The section--alt background sits behind. */
    background: var(--color-graphite);
    text-decoration: none;
    color: inherit;
    isolation: isolate;
  }
  .tile:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: -4px;
  }

  /* Photo mode — luminance-mapped duotone via inline SVG filter. */
  .tile__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url(#zo-duotone) contrast(1.05);
    transform: scale(1.01); /* hide subpixel filter edges */
    transition: transform 800ms var(--ease-snap);
    will-change: transform;
  }
  .tile:hover .tile__media,
  .tile:focus-visible .tile__media {
    transform: scale(1.06);
  }

  /* Typographic mode — discipline numeral as the visual hook.
     Gradient starts at graphite (not soot) so the tile reads distinct
     from the surrounding soot section frame. */
  .tile--type {
    background:
      radial-gradient(ellipse at 70% 30%, rgba(200,168,78,0.06) 0%, transparent 60%),
      linear-gradient(135deg, var(--color-graphite) 0%, var(--color-void) 100%);
  }
  .tile__numeral {
    position: absolute;
    top: clamp(var(--space-md), 4vw, var(--space-xl));
    right: clamp(var(--space-md), 4vw, var(--space-xl));
    font-family: var(--font-headline);
    font-size: clamp(5rem, 16vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-husk);
    user-select: none;
    pointer-events: none;
    transition: color 400ms var(--ease-snap), transform 600ms var(--ease-snap);
    z-index: 1;
  }
  .tile--type:hover .tile__numeral,
  .tile--type:focus-visible .tile__numeral {
    color: var(--color-wire);
    transform: translateY(-2px);
  }

  /* Hover affordance — "↗ View" tab in top-left. */
  .tile__arrow {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    z-index: 3;
    padding: 0.4rem 0.7rem;
    background: var(--color-void);
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 250ms var(--ease-snap), transform 300ms var(--ease-snap);
    pointer-events: none;
  }
  .tile:hover .tile__arrow,
  .tile:focus-visible .tile__arrow {
    opacity: 1;
    transform: translateY(0);
  }

  /* Bottom overlay — label always visible, kicker reveals on hover. */
  .tile__overlay {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    background: linear-gradient(
      to top,
      rgba(10, 10, 11, 0.95) 0%,
      rgba(10, 10, 11, 0.75) 55%,
      rgba(10, 10, 11, 0) 100%
    );
    transition: padding-bottom 300ms var(--ease-snap);
  }
  .tile__label {
    display: block;
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.05;
    color: var(--color-bone);
    letter-spacing: var(--tracking-tight);
  }
  .tile__kicker {
    display: block;
    margin-top: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-chalk);
    max-width: 32ch;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transform: translateY(6px);
    transition:
      opacity 280ms var(--ease-snap),
      max-height 360ms var(--ease-snap),
      transform 320ms var(--ease-snap);
  }
  .tile:hover .tile__kicker,
  .tile:focus-visible .tile__kicker {
    opacity: 1;
    max-height: 6em;
    transform: translateY(0);
  }

  /* CTA mode — Support tile carries red accent energy. Persistent
     2px signal-red top edge reads as CTA whether the tile is photo or
     typographic. */
  .tile--cta {
    background:
      radial-gradient(ellipse at 30% 70%, rgba(214,64,69,0.10) 0%, transparent 65%),
      linear-gradient(135deg, var(--color-graphite) 0%, var(--color-void) 100%);
    box-shadow: inset 0 2px 0 0 var(--color-signal);
  }
  .tile--cta .tile__numeral {
    color: rgba(163, 48, 53, 0.55);
  }
  .tile--cta:hover .tile__numeral,
  .tile--cta:focus-visible .tile__numeral {
    color: var(--color-signal);
  }
  .tile--cta .tile__label {
    color: var(--color-bone);
  }

  /* Brand-sticker mode — Wire tile only. The Phuckin' Wire mark sits
     centered as a paste-on sticker (slight rotation, drop shadow),
     preserving its native cream + ink palette. Echoes the existing
     masthead stamp pattern on /the-wire/ for cross-page consistency. */
  .tile--brand {
    background:
      radial-gradient(ellipse at 50% 35%, rgba(200,168,78,0.06) 0%, transparent 60%),
      linear-gradient(135deg, var(--color-graphite) 0%, var(--color-void) 100%);
  }
  .tile__sticker {
    position: absolute;
    left: 50%;
    top: 42%;
    width: clamp(150px, 55%, 260px);
    height: auto;
    transform: translate(-50%, -50%) rotate(-3deg);
    filter:
      drop-shadow(0 10px 22px rgba(0, 0, 0, 0.55))
      drop-shadow(0 2px 0 var(--color-signal-dim));
    transition: transform 600ms var(--ease-snap);
    z-index: 1;
    user-select: none;
    pointer-events: none;
  }
  .tile--brand:hover .tile__sticker,
  .tile--brand:focus-visible .tile__sticker {
    transform: translate(-50%, -50%) rotate(-3deg) scale(1.04);
  }

  /* Touch-class devices: surface the kicker permanently (no hover). */
  @media (hover: none) {
    .tile__kicker {
      opacity: 1;
      max-height: 6em;
      transform: none;
    }
    .tile__arrow {
      opacity: 0.6;
      transform: none;
    }
  }

  /* Respect reduced motion — kill the inner image zoom + numeral lift. */
  @media (prefers-reduced-motion: reduce) {
    .tile__media,
    .tile__numeral,
    .tile__arrow,
    .tile__kicker,
    .tile__sticker { transition: none; }
    .tile:hover .tile__media,
    .tile:focus-visible .tile__media { transform: scale(1.01); }
    .tile--brand:hover .tile__sticker,
    .tile--brand:focus-visible .tile__sticker {
      transform: translate(-50%, -50%) rotate(-3deg);
    }
  }

  /* Final CTA action row */
  .final-cta__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
