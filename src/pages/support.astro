---
import SubpageLayout from '../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Support" breadcrumbs={[{ label: "Support" }]}>
  <section class="hero hero--full">
    <div class="hero__inner">
      <div>
        <span class="hero__eyebrow">Make an Impact</span>
        <h1 class="hero__headline">Support the<br />Movement</h1>
        <p class="hero__subhead">Every dollar fuels creative work by incarcerated artists, funds new publications, and contributes to the UBFSF Community Grant Fund — building pathways to economic independence and justice reform.</p>
      </div>
    </div>
  </section>

  <!-- Donation Tiers -->
  <section class="section section--alt">
    <div class="container reveal">
      <span class="label">Give Today</span>
      <h2 class="text-center">Choose Your Impact</h2>
      <div class="grid grid--3" style="margin-top: var(--space-2xl);">
        <div class="card" style="padding: var(--space-xl); text-align: center;">
          <div class="signal-line"></div>
          <span class="stat__number" style="font-size: var(--text-3xl);">$25</span>
          <h3 class="card__title" style="margin-top: var(--space-sm);">Sustainer</h3>
          <p class="card__text">Covers one book's production costs — editing, layout, and printing for a single title by an incarcerated author.</p>
          <a href="#donate" class="btn btn--outline" style="margin-top: var(--space-lg); width: 100%;">Donate $25</a>
        </div>
        <div class="card" style="padding: var(--space-xl); text-align: center; border-color: var(--color-signal);">
          <div class="signal-line"></div>
          <span class="stat__number" style="font-size: var(--text-3xl); color: var(--color-signal);">$50</span>
          <h3 class="card__title" style="margin-top: var(--space-sm);">Champion</h3>
          <p class="card__text">Sponsors a creator's materials — paper, postage, and supplies needed to draft manuscripts from inside the facility.</p>
          <a href="#donate" class="btn btn--primary" style="margin-top: var(--space-lg); width: 100%;">Donate $50</a>
        </div>
        <div class="card" style="padding: var(--space-xl); text-align: center;">
          <div class="signal-line"></div>
          <span class="stat__number" style="font-size: var(--text-3xl);">$100</span>
          <h3 class="card__title" style="margin-top: var(--space-sm);">Patron</h3>
          <p class="card__text">Funds a full publication cycle — from manuscript to marketplace — putting a finished book into readers' hands.</p>
          <a href="#donate" class="btn btn--outline" style="margin-top: var(--space-lg); width: 100%;">Donate $100</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact / Distribution -->
  <section class="section">
    <div class="container reveal">
      <span class="label">Where It Goes</span>
      <h2 class="text-center">How Funds Are Distributed</h2>
      <div class="grid grid--2" style="margin-top: var(--space-2xl);">
        <div class="card" style="padding: var(--space-xl);">
          <span class="stat__number" style="font-size: var(--text-3xl); color: var(--color-wire);">50%</span>
          <h3 class="card__title" style="margin-top: var(--space-sm);">UBFSF Community Grant Fund</h3>
          <p class="card__text">Half of all revenue goes directly to the United Black Family Scholarship Foundation's Community Grant Fund — supporting education, reentry programs, and family assistance for incarcerated individuals.</p>
        </div>
        <div class="card" style="padding: var(--space-xl);">
          <span class="stat__number" style="font-size: var(--text-3xl); color: var(--color-phosphor);">50%</span>
          <h3 class="card__title" style="margin-top: var(--space-sm);">Cooperative Revenue Share</h3>
          <p class="card__text">The other half is shared among creators and reinvested into new projects — paying incarcerated authors, artists, and filmmakers for their work and funding the next wave of publications.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Ways to Help -->
  <section class="section section--alt">
    <div class="container reveal">
      <span class="label">Beyond Donations</span>
      <h2 class="text-center">Other Ways to Help</h2>
      <div class="grid grid--3" style="margin-top: var(--space-2xl);">
        <div class="card" style="padding: var(--space-xl);">
          <div class="signal-line"></div>
          <h3 class="card__title">Volunteer</h3>
          <p class="card__text">Join the cooperative as an outside co-chair. Student volunteers and community advocates partner directly with incarcerated members to lead projects.</p>
          <a href="/contact/" class="btn btn--outline" style="margin-top: var(--space-lg);">Get Involved</a>
        </div>
        <div class="card" style="padding: var(--space-xl);">
          <div class="signal-line"></div>
          <h3 class="card__title">Subscribe to The Wire</h3>
          <p class="card__text">Read and share our flagship newsletter — advocacy journalism written by and for incarcerated people. Every subscriber amplifies these voices.</p>
          <a href="/the-wire/" class="btn btn--outline" style="margin-top: var(--space-lg);">Read The Wire</a>
        </div>
        <div class="card" style="padding: var(--space-xl);">
          <div class="signal-line"></div>
          <h3 class="card__title">Share Our Work</h3>
          <p class="card__text">Follow us on social media and share our publications. Visibility is currency — every share reaches someone who needs to hear these stories.</p>
          <a href="/books/" class="btn btn--outline" style="margin-top: var(--space-lg);">Browse Books</a>
        </div>
      </div>
    </div>
  </section>
</SubpageLayout>
