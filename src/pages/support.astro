---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<SubpageLayout title="Support" breadcrumbs={[{ label: "Support" }]}>
  <section
    class="hero hero--editorial hero--editorial-left"
    style="--hero-image: url('/assets/images/support-cellblock.jpg'); --hero-image-position: center center;"
  >
    <div class="hero__inner">
      <span class="hero__eyebrow">Make an Impact</span>
      <h1 class="hero__headline">Support the<br />Movement</h1>
      <p class="hero__subhead">Every dollar fuels creative work by incarcerated artists, funds new publications, and contributes to the UBFSF Community Grant Fund, building pathways to economic independence and justice reform.</p>
    </div>
  </section>

  <!-- Donation Tiers -->
  <section class="section section--alt">
    <div class="container reveal">
      <SectionHeader eyebrow="Give Today" title="Choose Your Impact" align="center" />
      <div class="grid grid--3 mt-2xl">
        <div class="card support-tier">
          <div class="signal-line"></div>
          <span class="stat__number support-tier__amount">$25</span>
          <h3 class="card__title mt-sm">Sustainer</h3>
          <p class="card__text">Covers one book's production costs: editing, layout, and printing for a single title by an incarcerated author.</p>
          <a href="/contact/?intent=donate" class="btn btn--outline support-tier__cta">Donate $25</a>
        </div>
        <div class="card support-tier support-tier--recommended">
          <div class="signal-line"></div>
          <span class="stat__number support-tier__amount text-signal">$50</span>
          <h3 class="card__title mt-sm">Champion</h3>
          <p class="card__text">Sponsors a creator's materials: paper, postage, and supplies needed to draft manuscripts from inside the facility.</p>
          <a href="/contact/?intent=donate" class="btn btn--primary support-tier__cta">Donate $50</a>
        </div>
        <div class="card support-tier">
          <div class="signal-line"></div>
          <span class="stat__number support-tier__amount">$100</span>
          <h3 class="card__title mt-sm">Patron</h3>
          <p class="card__text">Funds a full publication cycle, from manuscript to marketplace, putting a finished book into readers' hands.</p>
          <a href="/contact/?intent=donate" class="btn btn--outline support-tier__cta">Donate $100</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact / Distribution -->
  <section class="section">
    <div class="container reveal">
      <SectionHeader eyebrow="Where It Goes" title="How Funds Are Distributed" align="center" />
      <div class="grid grid--2 mt-2xl">
        <div class="card support-distribution">
          <span class="stat__number support-distribution__pct text-wire">50%</span>
          <h3 class="card__title mt-sm">UBFSF Community Grant Fund</h3>
          <p class="card__text">Half of all revenue goes directly to the United Black Family Scholarship Foundation's Community Grant Fund, supporting education, reentry programs, and family assistance for incarcerated individuals.</p>
        </div>
        <div class="card support-distribution">
          <span class="stat__number support-distribution__pct support-distribution__pct--alt">50%</span>
          <h3 class="card__title mt-sm">Cooperative Revenue Share</h3>
          <p class="card__text">The other half is shared among creators and reinvested into new projects, paying incarcerated authors, artists, and filmmakers for their work and funding the next wave of publications.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Ways to Help -->
  <section class="section section--alt">
    <div class="container reveal">
      <SectionHeader eyebrow="Beyond Donations" title="Other Ways to Help" align="center" />
      <div class="grid grid--3 mt-2xl">
        <div class="card card--quiet support-help">
          <div class="signal-line"></div>
          <h3 class="card__title">Volunteer</h3>
          <p class="card__text">Join the cooperative as an outside co-chair. Student volunteers and community advocates partner directly with incarcerated members to lead projects.</p>
          <a href="/contact/" class="btn btn--outline mt-lg">Get Involved</a>
        </div>
        <div class="card card--quiet support-help">
          <div class="signal-line"></div>
          <h3 class="card__title">Subscribe to The Wire</h3>
          <p class="card__text">Read and share our flagship newsletter: advocacy journalism written by and for incarcerated people. Every subscriber amplifies these voices.</p>
          <a href="/the-wire/" class="btn btn--outline mt-lg">Read The Wire</a>
        </div>
        <div class="card card--quiet support-help">
          <div class="signal-line"></div>
          <h3 class="card__title">Share Our Work</h3>
          <p class="card__text">Follow us on social media and share our publications. Visibility is currency. Every share reaches someone who needs to hear these stories.</p>
          <a href="/books/" class="btn btn--outline mt-lg">Browse Books</a>
        </div>
      </div>
    </div>
  </section>
</SubpageLayout>

<style>
  /* Donation tier cards: roomy padding + centered content */
  .support-tier {
    padding: var(--space-xl);
    text-align: center;
  }
  .support-tier__amount {
    font-size: var(--text-3xl);
  }
  .support-tier__cta {
    margin-top: var(--space-lg);
    width: 100%;
  }
  /* Recommended tier — signal-red border draws the eye */
  .support-tier--recommended {
    border-color: var(--color-signal);
  }

  /* Fund-distribution showcase cards */
  .support-distribution {
    padding: var(--space-xl);
  }
  .support-distribution__pct {
    font-size: var(--text-3xl);
  }
  .support-distribution__pct--alt {
    color: var(--color-phosphor);
  }

  /* "Other Ways to Help" — quiet cards, consistent padding */
  .support-help {
    padding: var(--space-xl);
  }
</style>