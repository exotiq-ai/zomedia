---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<SubpageLayout title="Support" description="Explore ways to support creator-led literature, film, and art from incarcerated voices through Zo Media Productions." breadcrumbs={[{ label: "Support" }]}>
  <section
    class="hero hero--editorial hero--editorial-left"
    style="--hero-image: url('/assets/images/support-cellblock.jpg'); --hero-image-position: center center;"
  >
    <div class="hero__inner">
      <span class="hero__eyebrow">Make an Impact</span>
      <h1 class="hero__headline">Support the<br />Movement</h1>
      <p class="hero__subhead">Support creative work by incarcerated artists, new publications, and the community work that builds pathways to economic independence and justice reform.</p>
    </div>
  </section>

  <!-- Support pathways -->
  <section class="section section--alt">
    <div class="container reveal">
      <SectionHeader eyebrow="Support the Work" title="Choose How You Can Help" align="center" />
      <p class="support-intro">We are finalizing a secure online giving option. For now, contact us to discuss the kind of support that best fits your goals.</p>
      <div class="grid grid--3 mt-2xl">
        <div class="card support-tier">
          <div class="signal-line"></div>
          <h3 class="card__title">Fund a Publication</h3>
          <p class="card__text">Help bring an incarcerated author's work from manuscript through editing, design, and print.</p>
          <a href="/contact/?intent=donate" class="btn btn--outline support-tier__cta">Talk With Us</a>
        </div>
        <div class="card support-tier support-tier--recommended">
          <div class="signal-line"></div>
          <h3 class="card__title">Back a Creator</h3>
          <p class="card__text">Support the materials, correspondence, and creative infrastructure that help writers and artists develop their work.</p>
          <a href="/contact/?intent=donate" class="btn btn--primary support-tier__cta">Talk With Us</a>
        </div>
        <div class="card support-tier">
          <div class="signal-line"></div>
          <h3 class="card__title">Partner With Zo</h3>
          <p class="card__text">Explore institutional, sponsorship, and project-based support for the cooperative's next chapter.</p>
          <a href="/contact/?intent=donate" class="btn btn--outline support-tier__cta">Talk With Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact -->
  <section class="section">
    <div class="container reveal">
      <SectionHeader eyebrow="Where It Goes" title="How Support Builds Power" align="center" />
      <div class="grid grid--2 mt-2xl">
        <div class="card support-distribution">
          <h3 class="card__title">Community Support</h3>
          <p class="card__text">Zo Media works alongside the United Black Family Scholarship Foundation to expand education, reentry, and family-support opportunities for incarcerated people and their communities.</p>
        </div>
        <div class="card support-distribution">
          <h3 class="card__title">Creative Opportunity</h3>
          <p class="card__text">Support helps sustain creator-led publishing, film, and art projects while the cooperative builds new pathways for incarcerated authors, artists, and filmmakers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Ways to Help -->
  <section class="section section--alt">
    <div class="container reveal">
      <SectionHeader eyebrow="Beyond Donations" title="Other Ways to Help" align="center" />
      <div class="grid grid--3 mt-2xl">
        <div class="card card--quiet support-help">
          <div class="signal-line"></div>
          <h3 class="card__title">Volunteer</h3>
          <p class="card__text">Join the cooperative as an outside co-chair. Student volunteers and community advocates partner directly with incarcerated members to lead projects.</p>
          <a href="/contact/" class="btn btn--outline mt-lg">Get Involved</a>
        </div>
        <div class="card card--quiet support-help">
          <div class="signal-line"></div>
          <h3 class="card__title">Subscribe to The Wire</h3>
          <p class="card__text">Read and share our flagship newsletter: advocacy journalism written by and for incarcerated people. Every subscriber amplifies these voices.</p>
          <a href="/the-wire/" class="btn btn--outline mt-lg">Read The Wire</a>
        </div>
        <div class="card card--quiet support-help">
          <div class="signal-line"></div>
          <h3 class="card__title">Share Our Work</h3>
          <p class="card__text">Follow us on social media and share our publications. Visibility is currency. Every share reaches someone who needs to hear these stories.</p>
          <a href="/books/" class="btn btn--outline mt-lg">Browse Books</a>
        </div>
      </div>
    </div>
  </section>
</SubpageLayout>

<style>
  .support-intro {
    max-width: 58ch;
    margin: var(--space-lg) auto 0;
    color: var(--color-fog);
    text-align: center;
  }
  /* Support pathway cards: roomy padding + centered content */
  .support-tier {
    padding: var(--space-xl);
    text-align: center;
  }
  .support-tier__cta {
    margin-top: var(--space-lg);
    width: 100%;
  }
  /* Recommended tier — signal-red border draws the eye */
  .support-tier--recommended {
    border-color: var(--color-signal);
  }

  /* Impact showcase cards */
  .support-distribution {
    padding: var(--space-xl);
  }
  /* "Other Ways to Help" — quiet cards, consistent padding */
  .support-help {
    padding: var(--space-xl);
  }
</style>