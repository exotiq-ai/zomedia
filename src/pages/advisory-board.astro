---
import { getCollection } from 'astro:content';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import TeamCard from '../components/content/TeamCard.astro';

const title = "Advisory Board";
const description = "Strategic advisors guiding Zo Media Productions across publishing, film, scholarship, and justice reform.";
const breadcrumbs = [{ label: "Advisory Board" }];

const advisors = (await getCollection('team'))
  .filter((m) => m.data.category === 'advisory')
  .sort((a, b) => a.data.order - b.data.order);
---

<SubpageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hero hero--editorial hero--editorial-compact">
    <div class="container container--narrow">
      <h1 class="hero__headline">Advisory Board</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <p class="text-lg">
        The Advisory Board provides strategic guidance on publishing, scholarship, legal matters, and justice reform. These experienced academics and advocates, including partners at Stony Brook University, volunteer their expertise to help Zo Media Productions expand the reach of incarcerated voices.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeader title="Advisors" />
      <div class="team-list mt-xl">
        {advisors.map((member) => (
          <TeamCard
            name={member.data.name}
            role={member.data.role}
            photo={member.data.photo}
            bio={member.data.bio}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow text-center">
      <p class="text-lg">
        Interested in supporting our mission in an advisory capacity?
      </p>
      <a href="/contact/" class="btn btn--outline btn--lg mt-lg">Contact Us</a>
    </div>
  </section>
</SubpageLayout>
