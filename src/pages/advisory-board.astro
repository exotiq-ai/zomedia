---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const title = "Advisory Board";
const description = "Strategic advisors guiding Zo Media Productions across publishing, film, legal, and justice reform.";
const breadcrumbs = [{ label: "Advisory Board" }];

const advisors = [
  { name: "Name TBD", role: "Advisory Board Member", bio: "Bio coming soon." },
  { name: "Name TBD", role: "Advisory Board Member", bio: "Bio coming soon." },
  { name: "Name TBD", role: "Advisory Board Member", bio: "Bio coming soon." },
];
---

<SubpageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hero hero--editorial hero--editorial-compact">
    <div class="container container--narrow">
      <h1 class="hero__headline">Advisory Board</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <p class="text-lg">
        The Advisory Board provides strategic guidance on publishing, film, legal matters, and justice reform. These experienced professionals volunteer their expertise to help Zo Media Productions navigate industry challenges and expand the reach of incarcerated voices.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader title="Advisors" />
      <div class="grid grid--3 mt-xl">
        {advisors.map((member) => (
          <div class="card card--quiet text-center">
            <div class="team-photo-placeholder">
              <span class="team-photo-placeholder__label">Photo TBD</span>
            </div>
            <h3 class="card__title">{member.name}</h3>
            <p class="card__meta">{member.role}</p>
            <p class="card__text">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow text-center">
      <p class="text-lg">
        Interested in supporting our mission in an advisory capacity?
      </p>
      <a href="/contact/" class="btn btn--outline btn--lg mt-lg">Contact Us</a>
    </div>
  </section>
</SubpageLayout>

<style>
  .team-photo-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--color-graphite);
    margin: 0 auto var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .team-photo-placeholder__label {
    font-family: var(--font-mono);
    color: var(--color-fog);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
