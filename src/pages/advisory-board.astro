---
import SubpageLayout from '../layouts/SubpageLayout.astro';

const title = "Advisory Board";
const description = "Strategic advisors guiding Zo Media Productions across publishing, film, legal, and justice reform.";
const breadcrumbs = [{ label: "Advisory Board" }];

const advisors = [
  { name: "Name TBD", role: "Advisory Board Member", bio: "Bio coming soon." },
  { name: "Name TBD", role: "Advisory Board Member", bio: "Bio coming soon." },
  { name: "Name TBD", role: "Advisory Board Member", bio: "Bio coming soon." },
];
---

<SubpageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hero hero--minimal">
    <div class="container container--narrow">
      <span class="hero__eyebrow">GUIDANCE</span>
      <h1 class="hero__headline">Advisory Board</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <p class="text-lg">
        The Advisory Board provides strategic guidance on publishing, film, legal matters, and justice reform. These experienced professionals volunteer their expertise to help Zo Media Productions navigate industry challenges and expand the reach of incarcerated voices.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="divider">
        <span class="divider__label">Advisors</span>
      </div>
      <div class="grid grid--3" style="margin-top: var(--space-xl);">
        {advisors.map((member) => (
          <div class="card" style="text-align: center;">
            <div style="width: 120px; height: 120px; border-radius: 50%; background: var(--color-graphite); margin: 0 auto var(--space-md); display: flex; align-items: center; justify-content: center;">
              <span style="font-family: var(--font-mono); color: var(--color-ash); font-size: var(--text-tiny); text-transform: uppercase; letter-spacing: var(--tracking-wide);">Photo TBD</span>
            </div>
            <h3 class="card__title">{member.name}</h3>
            <p class="card__meta">{member.role}</p>
            <p class="card__text">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow" style="text-align: center;">
      <p class="text-lg" style="margin-bottom: var(--space-lg);">
        Interested in supporting our mission in an advisory capacity?
      </p>
      <a href="/contact/" class="btn btn--outline btn--lg">Contact Us</a>
    </div>
  </section>
</SubpageLayout>
