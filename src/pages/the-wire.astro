---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<SubpageLayout title="The Phuckin' Wire" description="Advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic." breadcrumbs={[{ label: "The Phuckin' Wire" }]}>

  <section class="hero hero--editorial hero--editorial-center section--dark">
    <div class="hero__inner">
      <span class="hero__eyebrow">THE PUBLICATION</span>
      <h1 class="hero__headline wire-headline">The Phuckin' Wire</h1>
      <p class="hero__subhead">Advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeader eyebrow="About the Wire" title="Journalism from the Inside" />
      <p class="text-lg mt-lg">The Phuckin' Wire is a newsletter covering criminal justice, creative work, and policy &mdash; written entirely by incarcerated people. Published by Zo Media Productions as a Substack, the Wire gives voice to those the system was designed to silence.</p>
      <p class="text-fog mt-md">Each issue features investigative reporting, personal essays, poetry, and commentary on the criminal justice system. No editorial filters. No outside gatekeepers. Just the truth, told by the people living it.</p>
    </div>
  </section>

  <div class="divider"><span class="divider__label">Subscribe</span></div>

  <section class="section section--alt">
    <div class="container container--narrow text-center">
      <SectionHeader
        eyebrow="Get Every Issue"
        title="Never miss a story from inside."
        align="center"
        eyebrowTone="signal"
      />
      <p class="text-lg mt-lg">The Wire is available free &mdash; with a paid tier for those who want to directly fund incarcerated journalists.</p>
      <form data-netlify="true" name="wire-subscribe" method="POST" class="wire-form">
        <input type="hidden" name="form-name" value="wire-subscribe" />
        <div class="wire-form__row">
          <input type="email" name="email" placeholder="your@email.com" required class="form-control" aria-label="Email address" />
          <button type="submit" class="btn btn--primary btn--lg">Subscribe</button>
        </div>
        <p class="wire-form__note">Free to read. Paid subscriptions fund the writers.</p>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeader eyebrow="Institutional Partners" title="Sponsorships" />
      <p class="text-lg mt-lg">The Wire is supported by institutional sponsors committed to amplifying incarcerated voices. Johns Hopkins University is a confirmed sponsor.</p>
      <p class="text-fog mt-md">Interested in sponsoring The Wire? Institutional and organizational sponsorships are available. Reach out to discuss how your institution can support independent journalism from inside the system.</p>
      <a href="/contact/" class="btn btn--outline mt-xl">Inquire About Sponsorship</a>
    </div>
  </section>

  <div class="divider"><span class="divider__label">Latest</span></div>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader eyebrow="Recent Issues" title="Latest from The Wire" />
      <div class="grid grid--3 mt-2xl">
        <div class="card card--quiet wire-placeholder">
          <span class="eyebrow">Coming Soon</span>
          <p class="card__text mt-sm">Issues will appear here as they are published.</p>
        </div>
        <div class="card card--quiet wire-placeholder">
          <span class="eyebrow">Coming Soon</span>
          <p class="card__text mt-sm">Subscribe above to get notified when new issues drop.</p>
        </div>
        <div class="card card--quiet wire-placeholder">
          <span class="eyebrow">Coming Soon</span>
          <p class="card__text mt-sm">The Wire publishes on a rolling basis.</p>
        </div>
      </div>
    </div>
  </section>

</SubpageLayout>

<style>
  .wire-headline {
    font-size: clamp(3rem, 8vw, 6rem);
  }
  .wire-form {
    margin-top: var(--space-2xl);
  }
  .wire-form__row {
    display: flex;
    gap: var(--space-sm);
    max-width: 500px;
    margin-inline: auto;
  }
  .wire-form__row .form-control {
    flex: 1;
  }
  .wire-form__note {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-fog);
    margin-top: var(--space-md);
  }

  /* Placeholder issue cards — centered, roomy */
  .wire-placeholder {
    text-align: center;
    padding: var(--space-2xl);
  }

  @media (max-width: 600px) {
    .wire-form__row {
      flex-direction: column;
    }
  }
</style>
</content>
</invoke>