---
import { Image } from 'astro:assets';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import SubscribeForm from '../components/forms/SubscribeForm.astro';
import phuckinWireMark from '../assets/images/zo-media/phuckin-wire-mark.jpg';
---

<SubpageLayout ogImage="/assets/og/the-wire.jpg" title="The Phuckin' Wire" description="Advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic." breadcrumbs={[{ label: "The Phuckin' Wire" }]}>

  <section class="hero hero--editorial hero--editorial-center section--dark wire-hero">
    <div class="hero__inner">
      {/* Wire masthead — the publication's mark as a printed patch on the dark page. */}
      <div class="wire-mark" aria-hidden="true">
        <Image
          src={phuckinWireMark}
          alt=""
          width={220}
          height={220}
          loading="eager"
          format="webp"
        />
      </div>
      <span class="hero__eyebrow">The Publication</span>
      <h1 class="hero__headline wire-headline">The Phuckin' Wire</h1>
      <p class="hero__subhead">Advocacy journalism written by and for incarcerated people. Unfiltered. Uncensored. Unapologetic.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeader eyebrow="About the Wire" title="Journalism from the Inside" />
      <p class="text-lg mt-lg">The Phuckin' Wire is a newsletter covering criminal justice, creative work, and policy, written entirely by incarcerated people. Published by Zo Media Productions as a Substack, the Wire gives voice to those the system was designed to silence.</p>
      <p class="text-fog mt-md">Each issue features investigative reporting, personal essays, poetry, and commentary on the criminal justice system. No editorial filters. No outside gatekeepers. Just the truth, told by the people living it.</p>
    </div>
  </section>

  <div class="divider"><span class="divider__label">Stay Updated</span></div>

  <section class="section section--alt">
    <div class="container container--narrow text-center">
      <SectionHeader
        eyebrow="Stay Updated"
        title="Stay close to stories from inside."
        align="center"
        eyebrowTone="signal"
      />
      <p class="text-lg mt-lg">The Wire is free. Share your email and we'll send new issues and announcements as they're published.</p>
      <div class="wire-form"><SubscribeForm source="wire" buttonLabel="Subscribe" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeader eyebrow="Institutional Partners" title="Sponsorships" />
      <p class="text-lg mt-lg">The Wire is supported by institutional sponsors committed to amplifying incarcerated voices. Johns Hopkins University is a confirmed sponsor.</p>
      <p class="text-fog mt-md">Interested in sponsoring The Wire? Institutional and organizational sponsorships are available. Reach out to discuss how your institution can support independent journalism from inside the system.</p>
      <a href="/contact/" class="btn btn--outline mt-xl">Inquire About Sponsorship</a>
    </div>
  </section>

</SubpageLayout>

<style>
  /* ───────────────────────────────────────────────────────────
   * WIRE HERO MASTHEAD — the Phuckin' Wire logo as a printed
   * patch sitting on the dark page. Keeps the logo's native
   * cream + ink palette; doesn't tint or invert. Slight rotation
   * and soft shadow read it as a stuck-on stamp/sticker — fits
   * the typesetter aesthetic of the rest of the site.
   * ─────────────────────────────────────────────────────────── */
  /* Compact masthead — kill the 60vh editorial fold. This page leads
     with content, not a full-screen title card, so the mark + headline
     sit in a tight band up top. */
  .wire-hero {
    min-height: auto;
  }
  .wire-hero .hero__inner {
    padding-block: var(--space-xl);
  }
  .wire-mark {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-md);
  }
  .wire-mark img {
    display: block;
    width: clamp(120px, 14vw, 168px);
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    transform: rotate(-3deg);
    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.45),
      0 2px 0 rgba(214, 64, 69, 0.18);
    transition: transform var(--duration-normal) var(--ease-snap);
  }
  .wire-mark:hover img {
    transform: rotate(-1deg) scale(1.02);
  }
  @media (prefers-reduced-motion: reduce) {
    .wire-mark img { transform: none; }
    .wire-mark:hover img { transform: none; }
  }

  .wire-headline {
    font-size: clamp(2.25rem, 6vw, 4rem);
  }
  .wire-form {
    margin: var(--space-2xl) auto 0;
    max-width: 500px;
    text-align: left;
  }
</style>
