---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';

// Self-hosted fonts via @fontsource — no cross-origin requests
import '@fontsource/instrument-serif/400.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';

import '../styles/reset.css';
import '../styles/variables.css';
import '../styles/global.css';
import '../styles/effects.css';
import '../styles/components.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'A media cooperative publishing literature, film, and art by incarcerated creators. A subsidiary of UBFSF.',
  ogImage = '/assets/images/og-image.png',
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url);
const ogImageUrl = new URL(ogImage, canonicalUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Zo Media Productions</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl.href} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  {currentPath === '/' && (
    <>
      <link rel="preload" href="/assets/video/hero-typewriter-poster.jpg" as="image" />
      <link rel="preload" href="/assets/video/hero-typewriter.webm" as="video" type="video/webm" />
    </>
  )}
  {currentPath === '/film-projects/' && (
    <link rel="preload" href="/assets/images/film-projects-hero-poster.jpg" as="image" />
  )}
  {currentPath === '/books/' && (
    <link rel="preload" href="/assets/images/bookshelves-hero-poster.jpg" as="image" />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Self-hosted fonts (Satoshi + Instrument Serif + Space Mono)
       no Google Fonts cross-origin requests -->
  <link rel="preload" href="/assets/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Astro View Transitions — smooth page-to-page navigation -->
  <ClientRouter />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Zo Media Productions, LLC",
    "url": "https://zomediaproductions.com",
    "description": "A media cooperative producing literature, film, and art by incarcerated creators.",
    "parentOrganization": {
      "@type": "Organization",
      "name": "United Black Family Scholarship Foundation"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "P.O. BOX 862",
      "addressLocality": "Bristow",
      "addressRegion": "OK",
      "postalCode": "74010"
    },
    "telephone": "+1-918-924-5872",
    "email": "info@zomediaproductions.com"
  })} />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav currentPath={currentPath} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/nav';
    import '../scripts/reveal';
  </script>
</body>
</html>
