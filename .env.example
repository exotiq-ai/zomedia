# Copy to `.env` for local work; set the same names in Netlify → Site settings → Environment variables.
# Only PUBLIC_* values are ever exposed to the browser. NEVER commit a real .env.

# ── Give Lively (donation widget) — docs/GIVE-LIVELY.md ─────────────────────
PUBLIC_GIVELIVELY_WIDGET_TYPE=simple
PUBLIC_GIVELIVELY_SCRIPT_SRC=
# Branded widget only:
PUBLIC_GIVELIVELY_WIDGET_SRC=

# ── Sanity CMS — docs/SANITY.md ──────────────────────────────────────────────
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Read token only needed if the dataset is private or for draft previews (server/build only):
SANITY_API_READ_TOKEN=

# ── Forms backend (Netlify Functions, server-side only) — docs/FORMS.md ─────
RESEND_API_KEY=
CONTACT_FROM="Zo Media <noreply@zomediaproductions.com>"
CONTACT_TO=info@zomediaproductions.com
# Optional JSON map: inquiry type → inbox
CONTACT_ROUTES=
CONTACT_AUTOREPLY=false
# buttondown | beehiiv | mailchimp
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
BEEHIIV_PUBLICATION_ID=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=
NEWSLETTER_DOUBLE_OPT_IN=true

# ── Analytics — docs/SEO.md ──────────────────────────────────────────────────
PUBLIC_GA4_ID=
PUBLIC_PLAUSIBLE_DOMAIN=

# ── Search Console / Bing verification (meta tags) ──────────────────────────
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
